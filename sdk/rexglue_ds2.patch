+struct GpuTraceState {
+  std::string dir = "gpu_trace";
+  uint32_t frames_per_arm = 1;
+  int64_t start = -1;
+  bool key = false;
+  uint32_t max_arms = 8;
+  uint32_t arms = 0;
+  uint32_t remaining = 0;
+  bool key_was_down = false;
+  FILE* f = nullptr;
+  uint32_t frame_counter = 0;
+  uint32_t seq = 0, draws = 0, copies = 0, pkt3 = 0, events = 0, failed = 0;
+  // R1-30: destination dump
+  bool dump_all = false;
+  std::vector<uint32_t> dump_addrs;
+  uint32_t dumps = 0;
+  struct PendingCopy {
+    bool valid = false;
+    uint32_t seq = 0, r2319 = 0, dest_base = 0, extent_start = 0, extent_length = 0;
+    uint32_t pitch = 0, height = 0, off_x = 0, off_y = 0, dest_info_raw = 0, dest_info = 0;
+    uint32_t tex_format = 0, bpp = 0, endian = 0, array = 0, slice = 0, swap = 0, is_depth = 0;
+    uint32_t width = 0, rect_h = 0;
+  } pending;
+};
+GpuTraceState g_gpu_trace;
+
+bool GpuTraceDumpWanted(uint32_t r2319, uint32_t dest_base) {
+  if (g_gpu_trace.dump_all) return true;
+  for (uint32_t a : g_gpu_trace.dump_addrs) {
+    if (a == r2319 || a == dest_base) return true;
+  }
+  return false;
+}
+
+bool GpuTraceInitFromEnv() {
+  const char* on = std::getenv("REX_GPU_TRACE");
+  if (!on || !*on || (on[0] == '0' && on[1] == 0)) {
+    return false;
+  }
+  if (const char* d = std::getenv("REX_GPU_TRACE_DIR"); d && *d) g_gpu_trace.dir = d;
+  if (const char* n = std::getenv("REX_GPU_TRACE_FRAMES"); n && *n) {
+    g_gpu_trace.frames_per_arm = std::clamp<uint32_t>(uint32_t(std::strtoul(n, nullptr, 10)), 1, 64);
+  }
+  if (const char* s = std::getenv("REX_GPU_TRACE_START"); s && *s) g_gpu_trace.start = std::strtoll(s, nullptr, 10);
+  if (const char* k = std::getenv("REX_GPU_TRACE_KEY"); k && k[0] == '1') g_gpu_trace.key = true;
+  if (const char* m = std::getenv("REX_GPU_TRACE_MAX_ARMS"); m && *m) {
+    g_gpu_trace.max_arms = uint32_t(std::strtoul(m, nullptr, 10));
+  }
+  if (const char* dl = std::getenv("REX_GPU_TRACE_DUMP"); dl && *dl) {  // R1-30
+    std::string_view rest(dl);
+    while (!rest.empty()) {
+      size_t comma = rest.find(',');
+      std::string tok(rest.substr(0, comma));
+      rest = comma == std::string_view::npos ? std::string_view() : rest.substr(comma + 1);
+      if (tok == "all" || tok == "ALL") {
+        g_gpu_trace.dump_all = true;
+      } else if (!tok.empty()) {
+        g_gpu_trace.dump_addrs.push_back(uint32_t(std::strtoul(tok.c_str(), nullptr, 16)));
+      }
+    }
+  }
+  return true;
+}
+
+const bool g_gpu_trace_env_read = (g_gpu_trace_enabled = GpuTraceInitFromEnv(), true);
+#if REX_PLATFORM_NX
+}  // namespace
+void NxGpuTraceRearmFromEnv() {
+  g_gpu_trace_enabled = GpuTraceInitFromEnv();
+  const char* inv = std::getenv("N3_INVALIDATE_EACH_SWAP");
+  g_nx_invalidate_each_swap = inv && inv[0] == '1';
+}
+namespace {
+#endif
+
+void GpuTraceOpen(uint32_t counter) {
+  std::error_code ec;
+  std::filesystem::create_directories(g_gpu_trace.dir, ec);
+  std::string path = g_gpu_trace.dir + "/gputrace_s" + std::to_string(counter) + ".tsv";
+  g_gpu_trace.f = std::fopen(path.c_str(), "wb");
+  g_gpu_trace.frame_counter = counter;
+  g_gpu_trace.seq = g_gpu_trace.draws = g_gpu_trace.copies = g_gpu_trace.pkt3 = 0;
+  g_gpu_trace.events = g_gpu_trace.failed = 0;
+  g_gpu_trace.dumps = 0;  // R1-30
+  g_gpu_trace.pending.valid = false;
+  g_gpu_trace_capturing = g_gpu_trace.f != nullptr;
+  if (g_gpu_trace.f) {
+    std::fprintf(g_gpu_trace.f, "FRAME\tswap_counter=%u\tarm=%u\tformat=r1_28_v1\n", counter,
+                 g_gpu_trace.arms);
+  }
+  REXGPU_INFO("GPU_TRACE open {} ok={}", path, g_gpu_trace.f != nullptr);
+}
+
+void GpuTraceClose(uint32_t frontbuffer_ptr, uint32_t width, uint32_t height) {
+  if (!g_gpu_trace.f) return;
+  std::fprintf(g_gpu_trace.f, "SWAP\tseq=%u\tfb=%08X\tw=%u\th=%u\tdraws=%u\tcopies=%u\tpkt3=%u\tevents=%u\tfailed=%u\n",
+               g_gpu_trace.seq, frontbuffer_ptr, width, height, g_gpu_trace.draws, g_gpu_trace.copies,
+               g_gpu_trace.pkt3, g_gpu_trace.events, g_gpu_trace.failed);
+  std::fclose(g_gpu_trace.f);
+  g_gpu_trace.f = nullptr;
+  g_gpu_trace_capturing = false;
+  std::string index = g_gpu_trace.dir + "/gputrace_index.tsv";
+  if (FILE* idx = std::fopen(index.c_str(), "ab")) {
+    std::fprintf(idx, "s%u\tarm=%u\tdraws=%u\tcopies=%u\tpkt3=%u\tevents=%u\tfailed=%u\n",
+                 g_gpu_trace.frame_counter, g_gpu_trace.arms, g_gpu_trace.draws, g_gpu_trace.copies,
+                 g_gpu_trace.pkt3, g_gpu_trace.events, g_gpu_trace.failed);
+    std::fclose(idx);
+  }
+  REXGPU_INFO("GPU_TRACE frame s{} draws={} copies={} pkt3={} events={} dumps={}",
+              g_gpu_trace.frame_counter, g_gpu_trace.draws, g_gpu_trace.copies, g_gpu_trace.pkt3,
+              g_gpu_trace.events, g_gpu_trace.dumps);
+}
+
+void GpuTraceSwap(uint32_t counter, uint32_t frontbuffer_ptr, uint32_t width, uint32_t height) {
+  if (g_gpu_trace.f) {
+    GpuTraceClose(frontbuffer_ptr, width, height);
+    if (g_gpu_trace.remaining) --g_gpu_trace.remaining;
+  }
+  if (g_gpu_trace.remaining == 0 && g_gpu_trace.arms < g_gpu_trace.max_arms) {
+    bool arm = g_gpu_trace.start >= 0 && int64_t(counter) >= g_gpu_trace.start;
+    if (arm) g_gpu_trace.start = -1;  // auto-arm once
+#if REX_PLATFORM_WIN32
+    if (g_gpu_trace.key) {
+      bool down = (GetAsyncKeyState(0x78 /* VK_F9 */) & 0x8000) != 0;
+      unsigned long pid = 0;
+      if (struct HWND__* fg = GetForegroundWindow()) GetWindowThreadProcessId(fg, &pid);
+      if (down && !g_gpu_trace.key_was_down && pid == GetCurrentProcessId()) arm = true;
+      g_gpu_trace.key_was_down = down;
+    }
+#endif
+    if (arm) {
+      ++g_gpu_trace.arms;
+      g_gpu_trace.remaining = g_gpu_trace.frames_per_arm;
+      REXGPU_INFO("GPU_TRACE armed at swap {} frames={} arm={}", counter, g_gpu_trace.frames_per_arm,
+                  g_gpu_trace.arms);
+    }
+  }
+  if (g_gpu_trace.remaining) {
+    GpuTraceOpen(counter + 1);  // the frame that ends with the next swap
+  }
+}
+
+void GpuTraceRegs(FILE* f, const RegisterFile& regs, const uint32_t* list, size_t n) {
+  for (size_t i = 0; i < n; ++i) {
+    std::fprintf(f, "\tr%04X=%08X", list[i], regs.values[list[i]]);
+  }
+}
+
+void GpuTraceTextures(FILE* f, const RegisterFile& regs, const Shader* s, const char* stage) {
+  if (!s || !s->is_ucode_analyzed()) return;
+  for (const auto& b : s->texture_bindings()) {
+    xenos::xe_gpu_texture_fetch_t t = regs.GetTextureFetch(b.fetch_constant);
+    const uint32_t* d = reinterpret_cast<const uint32_t*>(&t);
+    std::fprintf(f,
+                 "\ttex_%s%u=fc%u:base=%08X:fmt=%u:w=%u:h=%u:pitch=%u:tiled=%u:endian=%u:dim=%u:"
+                 "mip=%08X:raw=%08X,%08X,%08X,%08X,%08X,%08X",
+                 stage, unsigned(b.binding_index), b.fetch_constant, uint32_t(t.base_address) << 12,
+                 uint32_t(t.format), uint32_t(t.size_2d.width) + 1, uint32_t(t.size_2d.height) + 1,
+                 uint32_t(t.pitch) << 5, uint32_t(t.tiled), uint32_t(t.endianness),
+                 uint32_t(t.dimension), uint32_t(t.mip_address) << 12, d[0], d[1], d[2], d[3], d[4],
+                 d[5]);
+  }
+}
+
+void GpuTraceDraw(int phase, const RegisterFile& regs, const memory::Memory& memory,
+                  const Shader* vs, const Shader* ps, const char* opcode_name, uint32_t initiator,
+                  bool ok) {
+  FILE* f = g_gpu_trace.f;
+  if (!f) return;
+  const auto edram_mode = regs.Get<reg::RB_MODECONTROL>().edram_mode;
+  const bool is_copy = edram_mode == xenos::EdramMode::kCopy;
+  if (phase == 0) {
+    if (!is_copy) return;
+    ++g_gpu_trace.copies;
+    std::fprintf(f, "COPY\tseq=%u\top=%s\tinit=%08X", g_gpu_trace.seq++, opcode_name, initiator);
+    static const uint32_t kCopyRegs[] = {
+        XE_GPU_REG_RB_SURFACE_INFO, XE_GPU_REG_RB_COLOR_INFO, XE_GPU_REG_RB_COLOR1_INFO,
+        XE_GPU_REG_RB_COLOR2_INFO,  XE_GPU_REG_RB_COLOR3_INFO, XE_GPU_REG_RB_DEPTH_INFO,
+        XE_GPU_REG_RB_COPY_CONTROL, XE_GPU_REG_RB_COPY_DEST_BASE, XE_GPU_REG_RB_COPY_DEST_PITCH,
+        XE_GPU_REG_RB_COPY_DEST_INFO, XE_GPU_REG_RB_DEPTH_CLEAR, XE_GPU_REG_RB_COLOR_CLEAR,
+        XE_GPU_REG_RB_COLOR_CLEAR_LO, XE_GPU_REG_RB_COPY_SURFACE_SLICE, XE_GPU_REG_PA_SC_WINDOW_OFFSET,
+        XE_GPU_REG_PA_SC_WINDOW_SCISSOR_TL, XE_GPU_REG_PA_SC_WINDOW_SCISSOR_BR};
+    GpuTraceRegs(f, regs, kCopyRegs, std::size(kCopyRegs));
+    draw_util::ResolveInfo ri;
+    bool ri_ok = draw_util::GetResolveInfo(regs, memory, 1, 1, false, false, ri);
+    std::fprintf(f, "\tri_ok=%u", unsigned(ri_ok));
+    if (ri_ok) {
+      const auto& e = ri.IsCopyingDepth() ? ri.depth_edram_info : ri.color_edram_info;
+      uint32_t span_base = 0, span_row = 0, span_rows = 0, span_pitch = 0;
+      ri.GetCopyEdramTileSpan(span_base, span_row, span_rows, span_pitch);
+      std::fprintf(
+          f,
+          "\tsrc_select=%u\tcopy_depth=%u\tclear_depth=%u\tclear_color=%u\tedram_base_tiles=%u"
+          "\tedram_pitch_tiles=%u\tedram_format=%u\tedram_64bpp=%u\tedram_msaa=%u"
+          "\tcolor_orig_base=%u\tdepth_orig_base=%u\toff_x=%u\toff_y=%u\twidth=%u\theight=%u"
+          "\tspan_base=%u\tspan_row=%u\tspan_rows=%u\tspan_pitch=%u\tdest_base=%08X"
+          "\tdest_extent=%08X+%X\tdest_pitch=%u\tdest_height=%u\tdest_off_x=%u\tdest_off_y=%u"
+          "\tsample_select=%u\tdest_info=%08X\tdepth_clear=%08X\tcolor_clear=%08X:%08X",
+          uint32_t(ri.rb_copy_control.copy_src_select), unsigned(ri.IsCopyingDepth()),
+          unsigned(ri.IsClearingDepth()), unsigned(ri.IsClearingColor()), uint32_t(e.base_tiles),
+          uint32_t(e.pitch_tiles), uint32_t(e.format), uint32_t(e.format_is_64bpp),
+          uint32_t(e.msaa_samples), ri.color_original_base, ri.depth_original_base,
+          uint32_t(ri.coordinate_info.edram_offset_x_div_8) * 8,
+          uint32_t(ri.coordinate_info.edram_offset_y_div_8) * 8,
+          uint32_t(ri.coordinate_info.width_div_8) * 8, ri.height_div_8 * 8, span_base, span_row,
+          span_rows, span_pitch, ri.copy_dest_base, ri.copy_dest_extent_start,
+          ri.copy_dest_extent_length, uint32_t(ri.copy_dest_coordinate_info.pitch_aligned_div_32) * 32,
+          uint32_t(ri.copy_dest_coordinate_info.height_aligned_div_32) * 32,
+          uint32_t(ri.copy_dest_coordinate_info.offset_x_div_8) * 8,
+          uint32_t(ri.copy_dest_coordinate_info.offset_y_div_8) * 8,
+          uint32_t(ri.copy_dest_coordinate_info.copy_sample_select), ri.copy_dest_info.value,
+          ri.rb_depth_clear, ri.rb_color_clear, ri.rb_color_clear_lo);
+    }
+    std::fputc('\n', f);
+    // R1-30: remember the destination of this copy for the COPY_DONE dump.
+    auto& pc = g_gpu_trace.pending;
+    pc.valid = false;
+    if (ri_ok && (g_gpu_trace.dump_all || !g_gpu_trace.dump_addrs.empty())) {
+      pc.valid = true;
+      pc.seq = g_gpu_trace.seq - 1;
+      pc.r2319 = regs.values[XE_GPU_REG_RB_COPY_DEST_BASE];
+      pc.dest_info_raw = regs.values[XE_GPU_REG_RB_COPY_DEST_INFO];
+      pc.dest_base = ri.copy_dest_base;
+      pc.extent_start = ri.copy_dest_extent_start;
+      pc.extent_length = ri.copy_dest_extent_length;
+      pc.pitch = uint32_t(ri.copy_dest_coordinate_info.pitch_aligned_div_32) * 32;
+      pc.height = uint32_t(ri.copy_dest_coordinate_info.height_aligned_div_32) * 32;
+      pc.off_x = uint32_t(ri.copy_dest_coordinate_info.offset_x_div_8) * 8;
+      pc.off_y = uint32_t(ri.copy_dest_coordinate_info.offset_y_div_8) * 8;
+      pc.dest_info = ri.copy_dest_info.value;
+      pc.tex_format = uint32_t(ri.copy_dest_info.copy_dest_format);
+      const FormatInfo* fi = FormatInfo::Get(pc.tex_format);
+      pc.bpp = fi ? fi->bits_per_pixel : 0;
+      pc.endian = uint32_t(ri.copy_dest_info.copy_dest_endian);
+      pc.array = uint32_t(ri.copy_dest_info.copy_dest_array);
+      pc.slice = uint32_t(ri.copy_dest_info.copy_dest_slice);
+      pc.swap = uint32_t(ri.copy_dest_info.copy_dest_swap);
+      pc.is_depth = unsigned(ri.IsCopyingDepth());
+      pc.width = uint32_t(ri.coordinate_info.width_div_8) * 8;
+      pc.rect_h = ri.height_div_8 * 8;
+    }
+    return;
+  }
+  if (is_copy) {
+    std::fprintf(f, "COPY_DONE\tseq=%u\tok=%u\n", g_gpu_trace.seq - 1, unsigned(ok));
+    if (!ok) ++g_gpu_trace.failed;
+    // R1-30: dump the guest destination bytes (valid only with readback_resolve=full).
+    auto& pc = g_gpu_trace.pending;
+    if (ok && pc.valid && pc.seq == g_gpu_trace.seq - 1 && pc.extent_length &&
+        GpuTraceDumpWanted(pc.r2319, pc.dest_base)) {
+      char name[96];
+      std::snprintf(name, sizeof(name), "gputrace_s%u_copy%u_%08X.bin", g_gpu_trace.frame_counter,
+                    pc.seq, pc.r2319);
+      std::string path = g_gpu_trace.dir + "/" + name;
+      const uint8_t* src = memory.TranslatePhysical(pc.extent_start);
+      size_t wrote = 0;
+      if (FILE* b = std::fopen(path.c_str(), "wb")) {
+        wrote = std::fwrite(src, 1, pc.extent_length, b);
+        std::fclose(b);
+      }
+      const std::string rb = REXCVAR_GET(readback_resolve);
+      const unsigned vk_rb = unsigned(REXCVAR_GET(vulkan_readback_resolve));
+      char row[640];
+      std::snprintf(
+          row, sizeof(row),
+          "s%u\tseq=%u\tfile=%s\tbytes=%zu\tr2319=%08X\tdest_base=%08X\textent_start=%08X"
+          "\textent_length=%X\tformat=%u\tbpp=%u\tpitch=%u\theight=%u\ttiled=1\tarray=%u\tslice=%u"
+          "\tendian=%u\tswap=%u\tis_depth=%u\tdest_off_x=%u\tdest_off_y=%u\twidth=%u\trect_h=%u"
+          "\tdest_info=%08X\tr231B=%08X\treadback_resolve=%s\tvulkan_readback_resolve=%u\n",
+          g_gpu_trace.frame_counter, pc.seq, name, wrote, pc.r2319, pc.dest_base, pc.extent_start,
+          pc.extent_length, pc.tex_format, pc.bpp, pc.pitch, pc.height, pc.array, pc.slice,
+          pc.endian, pc.swap, pc.is_depth, pc.off_x, pc.off_y, pc.width, pc.rect_h, pc.dest_info,
+          pc.dest_info_raw, rb.c_str(), vk_rb);
+      std::fprintf(f, "DUMP\t%s", row);
+      std::string side = g_gpu_trace.dir + "/gputrace_dumps.tsv";
+      if (FILE* s = std::fopen(side.c_str(), "ab")) {
+        std::fputs(row, s);
+        std::fclose(s);
+      }
+      ++g_gpu_trace.dumps;
+    }
+    pc.valid = false;
+    return;
+  }
+  ++g_gpu_trace.draws;
+  if (!ok) ++g_gpu_trace.failed;
+  reg::VGT_DRAW_INITIATOR vi;
+  vi.value = initiator;
+  std::fprintf(f,
+               "DRAW\tseq=%u\top=%s\tok=%u\tprim=%u\tn=%u\tsrc=%u\tidx=%u\tedram_mode=%u"
+               "\tvs=%016llX\tps=%016llX\tvs_mx=%u\tps_mx=%u\tdma_base=%08X",
+               g_gpu_trace.seq++, opcode_name, unsigned(ok), uint32_t(vi.prim_type),
+               uint32_t(vi.num_indices), uint32_t(vi.source_select), uint32_t(vi.index_size),
+               uint32_t(edram_mode), (unsigned long long)(vs ? vs->ucode_data_hash() : 0),
+               (unsigned long long)(ps ? ps->ucode_data_hash() : 0),
+               unsigned(vs && vs->is_ucode_analyzed() ? vs->memexport_eM_written() : 0),
+               unsigned(ps && ps->is_ucode_analyzed() ? ps->memexport_eM_written() : 0),
+               regs.values[XE_GPU_REG_VGT_DMA_BASE]);
+  static const uint32_t kDrawRegs[] = {
+      XE_GPU_REG_RB_SURFACE_INFO,   XE_GPU_REG_RB_COLOR_INFO,     XE_GPU_REG_RB_COLOR1_INFO,
+      XE_GPU_REG_RB_COLOR2_INFO,    XE_GPU_REG_RB_COLOR3_INFO,    XE_GPU_REG_RB_DEPTH_INFO,
+      XE_GPU_REG_RB_COLOR_MASK,     XE_GPU_REG_RB_MODECONTROL,    XE_GPU_REG_RB_DEPTHCONTROL,
+      XE_GPU_REG_RB_COLORCONTROL,   XE_GPU_REG_RB_BLENDCONTROL0,  XE_GPU_REG_RB_BLENDCONTROL1,
+      XE_GPU_REG_RB_BLENDCONTROL2,  XE_GPU_REG_RB_BLENDCONTROL3,  XE_GPU_REG_PA_SC_WINDOW_OFFSET,
+      XE_GPU_REG_PA_SC_WINDOW_SCISSOR_TL, XE_GPU_REG_PA_SC_WINDOW_SCISSOR_BR,
+      XE_GPU_REG_PA_SC_SCREEN_SCISSOR_TL, XE_GPU_REG_PA_SC_SCREEN_SCISSOR_BR,
+      XE_GPU_REG_PA_CL_VTE_CNTL,    XE_GPU_REG_PA_SU_SC_MODE_CNTL, XE_GPU_REG_PA_CL_CLIP_CNTL,
+      XE_GPU_REG_PA_CL_VPORT_XSCALE, XE_GPU_REG_PA_CL_VPORT_XOFFSET, XE_GPU_REG_PA_CL_VPORT_YSCALE,
+      XE_GPU_REG_PA_CL_VPORT_YOFFSET, XE_GPU_REG_PA_CL_VPORT_ZSCALE, XE_GPU_REG_PA_CL_VPORT_ZOFFSET,
+      XE_GPU_REG_PA_SC_AA_MASK};
+  GpuTraceRegs(f, regs, kDrawRegs, std::size(kDrawRegs));
+  GpuTraceTextures(f, regs, vs, "vs");
+  GpuTraceTextures(f, regs, ps, "ps");
+  // NR4: device-shadow register blocks (D3DDevice GPU_*PACKET ranges, fetch, flow) + ALU hashes.
+  static const int nr4_on = [] { const char* e = std::getenv("NR4_REGS"); return e && e[0] == '1'; }();
+  if (nr4_on) {
+    static const uint32_t kNr4Blocks[][2] = {{0x2000, 16}, {0x2080, 3},  {0x2100, 21}, {0x2180, 5},
+                                             {0x2200, 12}, {0x2280, 21}, {0x2300, 38}, {0x2380, 8},
+                                             {0x4800, 192}, {0x4900, 40}};
+    for (const auto& b : kNr4Blocks) {
+      std::fprintf(f, "\tnr4_%04X=", b[0]);
+      for (uint32_t i = 0; i < b[1]; ++i) std::fprintf(f, "%08X", regs.values[b[0] + i]);
+    }
+    for (uint32_t half = 0; half < 2; ++half) {
+      uint64_t h = 1469598103934665603ull;
+      for (uint32_t i = 0; i < 1024; ++i) {
+        uint32_t v = regs.values[0x4000 + half * 1024 + i];
+        for (int k = 0; k < 4; ++k) { h ^= (v >> (k * 8)) & 0xFF; h *= 1099511628211ull; }
+      }
+      std::fprintf(f, half ? "\tnr4_alu_ps=%016llX" : "\tnr4_alu_vs=%016llX", (unsigned long long)h);
+    }
+    std::fprintf(f, "\tnr4_dma=%08X,%08X\tnr4_vsn=%u\tnr4_psn=%u", regs.values[XE_GPU_REG_VGT_DMA_BASE],
+                 regs.values[XE_GPU_REG_VGT_DMA_SIZE], unsigned(vs ? vs->ucode_dword_count() : 0),
+                 unsigned(ps ? ps->ucode_dword_count() : 0));
+  }
+  std::fputc('\n', f);
+}
+
+void GpuTracePkt3(const RegisterFile& regs, uint32_t opcode, uint32_t count, bool result) {
+  FILE* f = g_gpu_trace.f;
+  if (!f) return;
+  ++g_gpu_trace.pkt3;
+  switch (opcode) {
+    case xenos::PM4_DRAW_INDX:
+    case xenos::PM4_DRAW_INDX_2:
+    case xenos::PM4_XE_SWAP:
+    case xenos::PM4_NOP:
+    case xenos::PM4_SET_CONSTANT:
+    case xenos::PM4_SET_CONSTANT2:
+    case xenos::PM4_LOAD_ALU_CONSTANT:
+    case xenos::PM4_SET_SHADER_CONSTANTS:
+    case xenos::PM4_INDIRECT_BUFFER:
+    case xenos::PM4_INDIRECT_BUFFER_PFD:
+      return;  // draws/swaps have their own rows; constant uploads are summarised by count only
+    case xenos::PM4_EVENT_WRITE:
+    case xenos::PM4_EVENT_WRITE_SHD:
+    case xenos::PM4_EVENT_WRITE_EXT:
+    case xenos::PM4_EVENT_WRITE_ZPD:
+      ++g_gpu_trace.events;
+      std::fprintf(f, "EVENT\tseq=%u\top=%02X\tcount=%u\tinitiator=%08X\tok=%u\n", g_gpu_trace.seq++,
