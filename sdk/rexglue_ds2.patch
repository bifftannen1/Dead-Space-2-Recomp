diff --git a/src/core/exception_handler_nx.cpp b/src/core/exception_handler_nx.cpp
new file mode 100644
index 0000000..ef4aede
--- /dev/null
+++ b/src/core/exception_handler_nx.cpp
@@ -0,0 +1,124 @@
+/**
+ * @file        core/exception_handler_nx.cpp
+ * @brief       Horizon (NX) fault reporting: log + abort (N2, 2026-10-06)
+ *
+ * nn::os user exception handlers cannot return (the system panics; os_UserExceptionHandlerTypes.h
+ * :104), so on NX nothing may depend on a fault being handled: MMIO is a range check and
+ * write-watch is software (S4b). Install() records the handler (never called) and installs one
+ * process-wide reporter that prints pc/lr/sp/far/esr + x0..x30 to stderr and to
+ * sd:/ds2nx/n2_fault.txt (if the sd mount exists), then aborts.  Also hosts the SEH and debug
+ * break shims (seh_* / debug::Break / IsDebuggerAttached / DebugPrint) and DynamicLibrary (no
+ * dlopen on NX: Load() fails, every caller already handles that).
+ */
+
+#include <rex/platform.h>
+static_assert(REX_PLATFORM_NX, "This file is Horizon-only");
+
+#include <rex/dbg.h>
+#include <rex/exception_handler.h>
+#include <rex/platform/dynlib.h>
+#include <rex/platform/exceptions.h>
+#include <rex/platform/seh.h>
+
+#include <nn/fs.h>
+#include <nn/os/os_UserExceptionHandler.h>
+
+#include <atomic>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+
+namespace rex::arch {
+
+namespace {
+alignas(0x1000) uint8_t g_handler_stack[0x8000];
+nn::os::UserExceptionInfo g_info;
+std::atomic<bool> g_installed{false};
+
+void Reporter(nn::os::UserExceptionInfo* info) {
+  const auto& d = info->detail;
+  char buf[2048];
+  int n = std::snprintf(buf, sizeof(buf),
+                        "N2_FAULT type=0x%x pc=%016llx lr=%016llx sp=%016llx far=%016llx esr=%08x\n",
+                        unsigned(info->exceptionType), (unsigned long long)d.pc,
+                        (unsigned long long)d.lr, (unsigned long long)d.sp,
+                        (unsigned long long)d.far, unsigned(d.esr));
+  for (int i = 0; i < 31 && n < int(sizeof(buf)) - 40; ++i) {
+    n += std::snprintf(buf + n, sizeof(buf) - n, "x%d=%016llx%s", i, (unsigned long long)d.r[i],
+                       (i % 4 == 3) ? "\n" : " ");
+  }
+  n += std::snprintf(buf + n, sizeof(buf) - n, "\n");
+  std::fputs(buf, stderr);
+  nn::fs::FileHandle h;
+  nn::fs::DeleteFile("sd:/ds2nx/n2_fault.txt");
+  if (nn::fs::CreateFile("sd:/ds2nx/n2_fault.txt", n).IsSuccess() &&
+      nn::fs::OpenFile(&h, "sd:/ds2nx/n2_fault.txt", nn::fs::OpenMode_Write).IsSuccess()) {
+    nn::fs::WriteFile(h, 0, buf, size_t(n),
+                      nn::fs::WriteOption::MakeValue(nn::fs::WriteOptionFlag_Flush));
+    nn::fs::CloseFile(h);
+  }
+  std::abort();
+}
+}  // namespace
+
+void ExceptionHandler::Install(Handler fn, void* data) {
+  (void)fn;
+  (void)data;
+  if (!g_installed.exchange(true)) {
+    nn::os::SetUserExceptionHandler(Reporter, g_handler_stack, sizeof(g_handler_stack), &g_info);
+  }
+}
+
+void ExceptionHandler::Uninstall(Handler fn, void* data) {
+  (void)fn;
+  (void)data;
+}
+
+}  // namespace rex::arch
+
+namespace rex::platform {
+
+static thread_local SehThreadState tls_seh_state;
+static thread_local bool tls_seh_active = false;
+
+SehThreadState& seh_thread_state() { return tls_seh_state; }
+int seh_filter(uint32_t, void*) { return 0; }
+[[noreturn]] void seh_rethrow() { std::abort(); }
+void seh_initialize() {
+  // No signals on Horizon: a fault in SEH-protected guest code reaches the reporter above.
+  g_seh_initialized.store(true);
+}
+bool& seh_active() { return tls_seh_active; }
+
+DynamicLibrary::~DynamicLibrary() { Close(); }
+DynamicLibrary::DynamicLibrary(DynamicLibrary&& other) noexcept : handle_(other.handle_) {
+  other.handle_ = nullptr;
+}
+DynamicLibrary& DynamicLibrary::operator=(DynamicLibrary&& other) noexcept {
+  if (this != &other) {
+    Close();
+    handle_ = other.handle_;
+    other.handle_ = nullptr;
+  }
+  return *this;
+}
+bool DynamicLibrary::Load(const std::filesystem::path& path, SymbolResolution mode) {
+  (void)path;
+  (void)mode;
+  return false;  // no dlopen on Horizon (nn::ro needs NRO/NRR; DESIGN.md (c): link statically)
+}
+void DynamicLibrary::Close() { handle_ = nullptr; }
+void* DynamicLibrary::GetRawSymbol(const char* name) const {
+  (void)name;
+  return nullptr;
+}
+
+}  // namespace rex::platform
+
+namespace rex::debug {
+bool IsDebuggerAttached() { return false; }
+void Break() { std::fputs("N2 debug::Break (ignored on NX)\n", stderr); }
+namespace detail {
+void DebugPrint(const char* s) { std::fprintf(stderr, "%s\n", s); }
+}  // namespace detail
+}  // namespace rex::debug
diff --git a/src/core/fiber_nx.cpp b/src/core/fiber_nx.cpp
new file mode 100644
index 0000000..d11ba78
--- /dev/null
+++ b/src/core/fiber_nx.cpp
@@ -0,0 +1,80 @@
+/**
+ * @file        core/fiber_nx.cpp
+ * @brief       Horizon (NX) fibers on nn::os::FiberType (N2, 2026-10-06)
+ *
+ * The thread's own context is the nullptr fiber (nn::os::SwitchToFiber(nullptr) returns to it),
+ * so ConvertCurrentThread allocates nothing on the OS side.
+ */
+
+#include <rex/platform.h>
+static_assert(REX_PLATFORM_NX, "This file is Horizon-only");
+
+#include <rex/thread/fiber.h>
+
+#include <nn/os/os_Fiber.h>
+
+#include <cassert>
+#include <cstdlib>
+#include <new>
+
+namespace rex::thread {
+
+thread_local Fiber* Fiber::tls_current_ = nullptr;
+
+Fiber* Fiber::ConvertCurrentThread() {
+  auto* f = new Fiber();
+  f->is_thread_fiber_ = true;
+  f->nx_fiber_ = nullptr;
+  tls_current_ = f;
+  return f;
+}
+
+Fiber* Fiber::Create(size_t stack_size, void (*entry)(void*), void* arg) {
+  auto* f = new Fiber();
+  f->entry_ = entry;
+  f->arg_ = arg;
+  stack_size = (stack_size + 0xFFF) & ~size_t(0xFFF);
+  f->stack_ = std::aligned_alloc(0x1000, stack_size);
+  auto* nxf = static_cast<nn::os::FiberType*>(std::calloc(1, sizeof(nn::os::FiberType)));
+  if (!f->stack_ || !nxf) {
+    std::free(f->stack_);
+    std::free(nxf);
+    delete f;
+    return nullptr;
+  }
+  f->nx_fiber_ = nxf;
+  nn::os::InitializeFiber(
+      nxf,
+      [](void* a) -> nn::os::FiberType* {
+        // tls_current_ was set to this fiber by SwitchTo before the switch.
+        Fiber* self = Fiber::Current();
+        (void)a;
+        self->entry_(self->arg_);
+        // A ReXGlue fiber entry never returns (it switches away for good); if it does, go
+        // back to the thread context like the POSIX ucontext path with uc_link == nullptr.
+        return nullptr;
+      },
+      f, f->stack_, stack_size, nn::os::FiberFlag_NoStackGuard);
+  return f;
+}
+
+void Fiber::SwitchTo(Fiber* target) {
+  tls_current_ = target;
+  nn::os::SwitchToFiber(static_cast<nn::os::FiberType*>(target->nx_fiber_));
+}
+
+void Fiber::Destroy() {
+  if (is_thread_fiber_) {
+    tls_current_ = nullptr;
+  } else {
+    assert(this != tls_current_ && "Destroy called on the currently running fiber");
+    if (nx_fiber_) {
+      nn::os::FinalizeFiber(static_cast<nn::os::FiberType*>(nx_fiber_));
+      std::free(nx_fiber_);
+    }
+    std::free(stack_);
+  }
+  delete this;
+}
+
+}  // namespace rex::thread
