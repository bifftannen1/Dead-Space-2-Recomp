+// P4: one VkPipelineCache for the process when p4_vk_pipeline_cache_path is set.
+struct P4PipelineCache {
+  std::mutex mutex;
+  bool tried = false;
+  VkPipelineCache cache = VK_NULL_HANDLE;
+};
+P4PipelineCache& p4_pcache() {
+  static P4PipelineCache c;
+  return c;
+}
+template <typename T>
+T P4Proc(const ui::vulkan::VulkanDevice* vd, const char* name) {
+  // device_1_0.inc lacks these entry points; adding them would change the Functions layout for every unit.
+  return reinterpret_cast<T>(vd->vulkan_instance()->functions().vkGetDeviceProcAddr(vd->device(), name));
+}
+VkPipelineCache P4GetPipelineCache(const ui::vulkan::VulkanDevice* vd) {
+  const VkDevice device = vd->device();
+  const std::string& path = REXCVAR_GET(p4_vk_pipeline_cache_path);
+  if (path.empty()) return VK_NULL_HANDLE;
+  P4PipelineCache& c = p4_pcache();
+  std::lock_guard<std::mutex> lock(c.mutex);
+  if (!c.tried) {
+    c.tried = true;
+    std::vector<uint8_t> data;
+    if (FILE* f = std::fopen(path.c_str(), "rb")) {
+      std::fseek(f, 0, SEEK_END);
+      long n = std::ftell(f);
+      std::fseek(f, 0, SEEK_SET);
+      if (n > 0) {
+        data.resize(size_t(n));
+        if (std::fread(data.data(), 1, data.size(), f) != data.size()) data.clear();
+      }
+      std::fclose(f);
+    }
+    VkPipelineCacheCreateInfo ci = {};
+    ci.sType = VK_STRUCTURE_TYPE_PIPELINE_CACHE_CREATE_INFO;
+    ci.initialDataSize = data.size();
+    ci.pInitialData = data.empty() ? nullptr : data.data();
+    auto create = P4Proc<PFN_vkCreatePipelineCache>(vd, "vkCreatePipelineCache");
+    VkResult r = create ? create(device, &ci, nullptr, &c.cache) : VK_ERROR_INITIALIZATION_FAILED;
+    REXGPU_INFO("P4_PCACHE_INIT loaded_bytes={} result={} path={}", data.size(), int32_t(r), path);
+    if (r != VK_SUCCESS) c.cache = VK_NULL_HANDLE;
+  }
+  return c.cache;
+}
+void P4AfterPipeline(const ui::vulkan::VulkanDevice* vd, uint64_t vs,
+                     uint64_t ps) {
+  const bool idle = REXCVAR_GET(p4_wait_idle_after_pipeline);
+  const int32_t settle = REXCVAR_GET(p4_pipeline_settle_ms);
+  const std::string& path = REXCVAR_GET(p4_vk_pipeline_cache_path);
+  if (!idle && settle <= 0 && path.empty()) return;
+  const VkDevice device = vd->device();
+  auto t0 = std::chrono::steady_clock::now();
+  VkResult wr = VK_SUCCESS;
+  if (idle) {
+    auto wait = P4Proc<PFN_vkDeviceWaitIdle>(vd, "vkDeviceWaitIdle");
+    wr = wait ? wait(device) : VK_ERROR_INITIALIZATION_FAILED;
+  }
+  if (settle > 0) std::this_thread::sleep_for(std::chrono::milliseconds(settle));
+  size_t saved = 0;
+  P4PipelineCache& c = p4_pcache();
+  if (!path.empty() && c.cache != VK_NULL_HANDLE) {
+    std::lock_guard<std::mutex> lock(c.mutex);
+    size_t n = 0;
+    auto get = P4Proc<PFN_vkGetPipelineCacheData>(vd, "vkGetPipelineCacheData");
+    if (get && get(device, c.cache, &n, nullptr) == VK_SUCCESS && n) {
+      std::vector<uint8_t> d(n);
+      if (get(device, c.cache, &n, d.data()) == VK_SUCCESS) {
+        if (FILE* f = std::fopen(path.c_str(), "wb")) {
+          saved = std::fwrite(d.data(), 1, n, f);
+          std::fclose(f);
+        }
+      }
+    }
+  }
+  REXGPU_INFO("P4_PIPE vs={:016X} ps={:016X} wait_idle={} settle_ms={} cache_saved={} us={}", vs, ps,
+              idle ? int32_t(wr) : 1, settle, saved,
+              std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::steady_clock::now() - t0)
+                  .count());
+}
