new file mode 100644
index 0000000..25030d8
--- /dev/null
+++ b/src/audio/nx/nx_audio_system_nx.cpp
@@ -0,0 +1,245 @@
+/**
+ * @file        audio/nx/nx_audio_system_nx.cpp
+ * @brief       Horizon (NX) nn::audio AudioOut driver (P6, 2026-10-06) - see the header.
+ */
+
+#include <rex/audio/audio_driver.h>
+#include <rex/audio/conversion.h>
+#include <rex/audio/downmix.h>
+#include <rex/audio/nx/nx_audio_system_nx.h>
+#include <rex/logging.h>
+#include <rex/thread.h>
+
+#include <nn/audio.h>
+#include <nn/os.h>
+
+#include <algorithm>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <deque>
+#include <mutex>
+#include <thread>
+#include <vector>
+
+namespace rex::audio::nx {
+
+NxAudioStats& GetNxAudioStats() {
+  static NxAudioStats s;
+  return s;
+}
+
+namespace {
+constexpr uint32_t kRate = 48000;
+constexpr uint32_t kGuestChannels = 6;
+constexpr uint32_t kChannelSamples = 256;  // one XAudio frame
+constexpr uint32_t kGuestFrameFloats = kGuestChannels * kChannelSamples;
+constexpr size_t kOutDataSize = kChannelSamples * 2 * sizeof(int16_t);  // stereo PCM16
+constexpr size_t kOutBufferSize = nn::audio::AudioOutBuffer::SizeGranularity;  // 4096 >= 1024
+constexpr int kOutBuffers = 6;  // 6 x 5.33 ms in flight
+constexpr size_t kStackSize = 64 * 1024;
+// Above the guest/default threads (16), below the N2 heartbeat (0): the thread sleeps on the
+// AudioOut event almost all the time, and Horizon never preempts for equal priority (N2 run8-11).
+constexpr int kThreadPriority = nn::os::HighestThreadPriority + 4;
+
+class NxAudioDriver final : public AudioDriver {
+ public:
+  NxAudioDriver(memory::Memory* memory, rex::thread::Semaphore* semaphore)
+      : AudioDriver(memory), semaphore_(semaphore) {}
+
+  bool Initialize() {
+    auto& st = GetNxAudioStats();
+    nn::audio::AudioOutParameter param;
+    nn::audio::InitializeAudioOutParameter(&param);
+    param.sampleRate = kRate;
+    param.channelCount = 2;
+    nn::Result r = nn::audio::OpenDefaultAudioOut(&out_, &event_, param);
+    if (r.IsFailure()) {
+      st.open_result = int32_t(r.GetInnerValueForDebug());
+      REXAPU_ERROR("NxAudio: OpenDefaultAudioOut failed {:08X}", uint32_t(r.GetInnerValueForDebug()));
+      return false;
+    }
+    opened_ = true;
+    st.rate = nn::audio::GetAudioOutSampleRate(&out_);
+    st.channels = nn::audio::GetAudioOutChannelCount(&out_);
+    const int fmt = int(nn::audio::GetAudioOutSampleFormat(&out_));
+    if (st.rate != int(kRate) || st.channels != 2 || fmt != int(nn::audio::SampleFormat_PcmInt16)) {
+      REXAPU_ERROR("NxAudio: unexpected AudioOut {} Hz {} ch fmt {}", st.rate.load(),
+                   st.channels.load(), fmt);
+      return false;
+    }
+    for (int i = 0; i < kOutBuffers; ++i) {
+      mem_[i] = aligned_alloc(nn::audio::AudioOutBuffer::AddressAlignment, kOutBufferSize);
+      std::memset(mem_[i], 0, kOutBufferSize);
+      nn::audio::SetAudioOutBufferInfo(&bufs_[i], mem_[i], kOutBufferSize, kOutDataSize);
+      nn::audio::AppendAudioOutBuffer(&out_, &bufs_[i]);
+    }
+    r = nn::audio::StartAudioOut(&out_);
+    if (r.IsFailure()) {
+      st.open_result = int32_t(r.GetInnerValueForDebug());
+      REXAPU_ERROR("NxAudio: StartAudioOut failed {:08X}", uint32_t(r.GetInnerValueForDebug()));
+      return false;
+    }
+    st.open_result = 0;
+    if (const char* d = std::getenv("P6_AUDIO_DUMP_FRAMES")) {
+      dump_frames_ = uint32_t(std::strtoul(d, nullptr, 10));
+      dump_.reserve(size_t(dump_frames_) * kChannelSamples * 2);
+    }
+    stack_ = aligned_alloc(nn::os::ThreadStackAlignment, kStackSize);
+    if (nn::os::CreateThread(&thread_, &NxAudioDriver::ThreadEntry, this, stack_, kStackSize,
+                             kThreadPriority)
+            .IsFailure()) {
+      REXAPU_ERROR("NxAudio: CreateThread failed");
+      return false;
+    }
+    nn::os::SetThreadName(&thread_, "NxAudioOut");
+    nn::os::StartThread(&thread_);
+    thread_started_ = true;
+    REXAPU_INFO("NxAudio: AudioOut 48000 Hz 2 ch PCM16, {} x {} samples, thread prio {}",
+                kOutBuffers, kChannelSamples, kThreadPriority);
+    return true;
+  }
+
+  ~NxAudioDriver() override {
+    stop_ = true;
+    if (thread_started_) {
+      nn::os::WaitThread(&thread_);
+      nn::os::DestroyThread(&thread_);
+    }
+    if (opened_) {
+      nn::audio::StopAudioOut(&out_);
+      nn::audio::CloseAudioOut(&out_);
+    }
+    for (void* m : mem_) std::free(m);
+    std::free(stack_);
+    for (float* f : queued_) delete[] f;
+    for (float* f : unused_) delete[] f;
+  }
+
+  void SubmitFrame(uint32_t frame_ptr) override {
+    const float* in = memory_->TranslateVirtual<float*>(frame_ptr);
+    float* f;
+    {
+      std::lock_guard<std::mutex> g(mutex_);
+      if (unused_.empty()) {
+        f = new float[kGuestFrameFloats];
+      } else {
+        f = unused_.back();
+        unused_.pop_back();
+      }
+    }
+    std::memcpy(f, in, kGuestFrameFloats * sizeof(float));
+    {
+      std::lock_guard<std::mutex> g(mutex_);
+      queued_.push_back(f);
+    }
+    GetNxAudioStats().submitted.fetch_add(1);
+  }
+
+ private:
+  static void ThreadEntry(void* arg) { static_cast<NxAudioDriver*>(arg)->Run(); }
+
+  // Returns true when a guest frame was consumed (and the semaphore released).
+  bool Fill(int16_t* out) {
+    auto& st = GetNxAudioStats();
+    float* f = nullptr;
+    {
+      std::lock_guard<std::mutex> g(mutex_);
+      if (!queued_.empty()) {
+        f = queued_.front();
+        queued_.pop_front();
+      }
+    }
+    if (!f) {
+      std::memset(out, 0, kOutDataSize);
+      if (st.submitted.load() != 0) st.underruns.fetch_add(1);
+      return false;
+    }
+    conversion::sequential_6_BE_to_interleaved_2_LE(mix_, f, kChannelSamples, GetStereoFold(),
+                                                    GetOutputGain());
+    bool loud = false;
+    for (uint32_t i = 0; i < kChannelSamples * 2; ++i) {
+      const float v = std::clamp(mix_[i], -1.0f, 1.0f);
+      out[i] = int16_t(v * 32767.0f);
+      loud |= out[i] != 0;
+    }
+    {
+      std::lock_guard<std::mutex> g(mutex_);
+      unused_.push_back(f);
+    }
+    st.played.fetch_add(1);
+    if (loud) st.nonsilent.fetch_add(1);
+    if (dump_frames_ && dumped_ < dump_frames_ && (loud || dumped_)) {  // start at first sound
+      dump_.insert(dump_.end(), out, out + kChannelSamples * 2);
+      if (++dumped_ == dump_frames_) WriteDump();
+    }
+    semaphore_->Release(1, nullptr);
+    return true;
+  }
+
+  void WriteDump() {
+    // Raw s16le stereo 48 kHz; written once from this thread (one ~1 s stall per run at most).
+    if (FILE* fp = std::fopen("sd:/ds2nx/p6_audio_s16le_48k_2ch.raw", "wb")) {
+      std::fwrite(dump_.data(), sizeof(int16_t), dump_.size(), fp);
+      std::fclose(fp);
+      REXAPU_INFO("NxAudio: dumped {} frames to sd:/ds2nx/p6_audio_s16le_48k_2ch.raw", dumped_);
+    }
+    std::vector<int16_t>().swap(dump_);
+  }
+
+  void Run() {
+    auto& st = GetNxAudioStats();
+    while (!stop_) {
+      if (!event_.TimedWait(nn::TimeSpan::FromMilliSeconds(50))) continue;
+      st.wakeups.fetch_add(1);
+      while (nn::audio::AudioOutBuffer* b = nn::audio::GetReleasedAudioOutBuffer(&out_)) {
+        Fill(static_cast<int16_t*>(nn::audio::GetAudioOutBufferDataPointer(b)));
+        nn::audio::AppendAudioOutBuffer(&out_, b);
+      }
+      st.hw_played_samples = nn::audio::GetAudioOutPlayedSampleCount(&out_);
+    }
+  }
+
+  rex::thread::Semaphore* semaphore_;
+  nn::audio::AudioOut out_{};
+  nn::os::SystemEvent event_;
+  nn::audio::AudioOutBuffer bufs_[kOutBuffers]{};
+  void* mem_[kOutBuffers]{};
+  float mix_[kChannelSamples * 2];
+  bool opened_ = false;
+  nn::os::ThreadType thread_{};
+  void* stack_ = nullptr;
+  bool thread_started_ = false;
+  std::atomic<bool> stop_{false};
+  std::mutex mutex_;
+  std::deque<float*> queued_;
+  std::vector<float*> unused_;
+  uint32_t dump_frames_ = 0, dumped_ = 0;
+  std::vector<int16_t> dump_;
+};
+}  // namespace
+
+std::unique_ptr<AudioSystem> NxAudioSystem::Create(runtime::FunctionDispatcher* function_dispatcher) {
+  return std::make_unique<NxAudioSystem>(function_dispatcher);
+}
+
+NxAudioSystem::NxAudioSystem(runtime::FunctionDispatcher* function_dispatcher)
+    : AudioSystem(function_dispatcher) {}
+
+NxAudioSystem::~NxAudioSystem() = default;
+
+X_STATUS NxAudioSystem::CreateDriver(size_t index, rex::thread::Semaphore* semaphore,
+                                     AudioDriver** out_driver) {
+  (void)index;
+  auto* d = new NxAudioDriver(memory_, semaphore);
+  if (!d->Initialize()) {
+    delete d;
+    return X_STATUS_UNSUCCESSFUL;
+  }
+  *out_driver = d;
+  return X_STATUS_SUCCESS;
+}
+
+void NxAudioSystem::DestroyDriver(AudioDriver* driver) { delete driver; }
+
+}  // namespace rex::audio::nx
