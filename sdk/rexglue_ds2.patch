+namespace {
+struct P7Warm {
+  std::mutex mutex;
+  bool tried = false, ok = false;
+  VkCommandPool pool = VK_NULL_HANDLE;
+  VkCommandBuffer cb = VK_NULL_HANDLE;
+  VkFence fence = VK_NULL_HANDLE;
+  uint64_t n = 0;
+};
+P7Warm& p7_warm() {
+  static P7Warm w;
+  return w;
+}
+void P7Warmup(const ui::vulkan::VulkanDevice* vd, VkPipeline pipeline) {
+  if (p7_nx_after_pipeline_create) p7_nx_after_pipeline_create();  // P7 step 2
+  if (REXCVAR_GET(p7_nx_pipeline_warmup) != 1) return;
+  const ui::vulkan::VulkanDevice::Functions& dfn = vd->functions();
+  const VkDevice device = vd->device();
+  P7Warm& w = p7_warm();
+  std::lock_guard<std::mutex> lock(w.mutex);
+  if (!w.tried) {
+    w.tried = true;
+    VkCommandPoolCreateInfo pci{VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO};
+    pci.flags = VK_COMMAND_POOL_CREATE_TRANSIENT_BIT;
+    pci.queueFamilyIndex = vd->queue_family_graphics_compute();
+    VkCommandBufferAllocateInfo cai{VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO};
+    cai.level = VK_COMMAND_BUFFER_LEVEL_PRIMARY;
+    cai.commandBufferCount = 1;
+    VkFenceCreateInfo fci{VK_STRUCTURE_TYPE_FENCE_CREATE_INFO};
+    w.ok = dfn.vkCreateCommandPool(device, &pci, nullptr, &w.pool) == VK_SUCCESS &&
+           ((cai.commandPool = w.pool), dfn.vkAllocateCommandBuffers(device, &cai, &w.cb) == VK_SUCCESS) &&
+           dfn.vkCreateFence(device, &fci, nullptr, &w.fence) == VK_SUCCESS;
+    REXGPU_INFO("P7_WARM_INIT ok={}", w.ok);
+  }
+  if (!w.ok) return;
+  const auto t0 = std::chrono::steady_clock::now();
+  VkResult r = dfn.vkResetCommandPool(device, w.pool, 0);
+  VkCommandBufferBeginInfo bi{VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO};
+  bi.flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT;
+  if (r == VK_SUCCESS) r = dfn.vkBeginCommandBuffer(w.cb, &bi);
+  if (r == VK_SUCCESS) {
+    dfn.vkCmdBindPipeline(w.cb, VK_PIPELINE_BIND_POINT_GRAPHICS, pipeline);
+    r = dfn.vkEndCommandBuffer(w.cb);
+  }
+  if (r == VK_SUCCESS) r = dfn.vkResetFences(device, 1, &w.fence);
+  if (r == VK_SUCCESS) {
+    VkSubmitInfo si{VK_STRUCTURE_TYPE_SUBMIT_INFO};
+    si.commandBufferCount = 1;
+    si.pCommandBuffers = &w.cb;
+    ui::vulkan::VulkanDevice::Queue::Acquisition q = vd->AcquireQueue(vd->queue_family_graphics_compute(), 0);
+    r = dfn.vkQueueSubmit(q.queue(), 1, &si, w.fence);
+  }
+  if (r == VK_SUCCESS) r = dfn.vkWaitForFences(device, 1, &w.fence, VK_TRUE, UINT64_MAX);
+  const uint64_t n = ++w.n;
+  if (n <= 64 || (n & 255) == 0 || r != VK_SUCCESS) {
+    REXGPU_INFO("P7_WARM n={} r={} us={}", n, int32_t(r),
+                std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::steady_clock::now() - t0)
+                    .count());
+  }
+}
