+bool SpirvShaderTranslator::P3AdoptPrecompiled(Shader::Translation& translation,
+                                               std::vector<uint8_t> spirv,
+                                               const uint8_t* texture_records, uint32_t texture_count,
+                                               const uint8_t* sampler_records,
+                                               uint32_t sampler_count) {
+  SpirvShader* spirv_shader = dynamic_cast<SpirvShader*>(&translation.shader());
+  if (!spirv_shader || spirv.empty() || (spirv.size() & 3)) {
+    return false;
+  }
+  if (!spirv_shader->bindings_setup_entered_.test_and_set(std::memory_order_relaxed)) {
+    spirv_shader->texture_bindings_.clear();
+    spirv_shader->texture_bindings_.reserve(texture_count);
+    for (uint32_t i = 0; i < texture_count; ++i) {
+      const uint8_t* r = texture_records + i * 3;
+      SpirvShader::TextureBinding& b = spirv_shader->texture_bindings_.emplace_back();
+      std::memset(&b, 0, sizeof(b));
+      b.fetch_constant = r[0];
+      b.dimension = xenos::FetchOpDimension(r[1]);
+      b.is_signed = r[2];
+      spirv_shader->used_texture_mask_ |= UINT32_C(1) << r[0];
+    }
+    spirv_shader->sampler_bindings_.clear();
+    spirv_shader->sampler_bindings_.reserve(sampler_count);
+    for (uint32_t i = 0; i < sampler_count; ++i) {
+      const uint8_t* r = sampler_records + i * 5;
+      SpirvShader::SamplerBinding& b = spirv_shader->sampler_bindings_.emplace_back();
+      b.fetch_constant = r[0];
+      b.mag_filter = xenos::TextureFilter(r[1]);
+      b.min_filter = xenos::TextureFilter(r[2]);
+      b.mip_filter = xenos::TextureFilter(r[3]);
+      b.aniso_filter = xenos::AnisoFilter(r[4]);
+    }
+  }
+  P3SetTranslatedBinary(translation, std::move(spirv));
+  return true;
+}
