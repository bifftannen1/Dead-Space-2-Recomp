diff --git a/include/rex/system/nx_memory_model.h b/include/rex/system/nx_memory_model.h
new file mode 100644
index 0000000..1b9b142
--- /dev/null
+++ b/include/rex/system/nx_memory_model.h
@@ -0,0 +1,106 @@
+// S4b (2026-10-06): NX memory model, enabled only when REX_NX_MEMORY_MODEL is defined non-zero.
+//
+// The Xbox 360 mirror views are not mapped. Only the canonical ranges exist in host memory:
+//   host offset [0x000000000, 0x07F000000)  guest virtual 0x00000000-0x7EFFFFFF
+//   host offset [0x080000000, 0x090000000)  guest xex     0x80000000-0x8FFFFFFF
+//   host offset [0x100000000, 0x120000000)  guest physical 0x00000000-0x1FFFFFFF
+// and every other guest range is translated onto them (map_info in xmemory.cpp):
+//   0x7F -> phys + (a - 0x7F000000)      0x90 -> a - 0x10000000
+//   0xA0 -> phys + (a - 0xA0000000)      0xC0 -> phys + (a - 0xC0000000)
+//   0xE0 -> phys + (a - 0xE0000000) + 0x1000
+// MMIO is an explicit range check (no fault): [0x7FC80000, 0x80000000) is offered to the
+// registered MMIO ranges (GPU 0x7FC80000/0xFFFF0000, XMA 0x7FEA0000/0xFFFF0000); anything not
+// claimed falls through to memory.
+// Write-watch is software: a watched-page bitmap (one bit per 4 KB physical host page) at
+// host offset kSideTableOffset (an otherwise unmapped hole, since 0x7F is translated), and a
+// sticky dirty-page bitmap after it. A store whose page bit is set calls WatchHit() before the
+// store lands (same order as the fault path), which marks the page dirty and runs the
+// existing physical-memory invalidation callbacks.
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+
+namespace rex::nxmem {
+
+constexpr uint64_t kPhysBase = 0x100000000ull;
+constexpr uint64_t kSideTableOffset = 0x7F000000ull;
+constexpr uint32_t kPageShift = 12;
+constexpr uint32_t kBitmapPages = 0x40000;  // covers 1 GB of physical host offsets (> 512 MB + 4 KB)
+constexpr size_t kBitmapBytes = kBitmapPages / 8;  // 32 KB
+constexpr uint64_t kWatchBitmapOffset = kSideTableOffset;
+constexpr uint64_t kDirtyBitmapOffset = kSideTableOffset + kBitmapBytes;
+constexpr size_t kSideTableBytes = 2 * kBitmapBytes;
+constexpr uint32_t kMmioWindowBase = 0x7FC80000u;
+constexpr uint32_t kMmioWindowSize = 0x00380000u;  // to 0x80000000
+
+struct DeltaTable {
+  int64_t d[256];
+};
+
+constexpr DeltaTable MakeDeltaTable() {
+  DeltaTable t{};
+  for (int hi = 0; hi < 256; ++hi) {
+    int64_t d = 0;
+    if (hi == 0x7F) {
+      d = int64_t(kPhysBase) - 0x7F000000ll;
+    } else if (hi >= 0x90 && hi <= 0x9F) {
+      d = -0x10000000ll;
+    } else if (hi >= 0xA0 && hi <= 0xBF) {
+      d = int64_t(kPhysBase) - 0xA0000000ll;
+    } else if (hi >= 0xC0 && hi <= 0xDF) {
+      d = int64_t(kPhysBase) - 0xC0000000ll;
+    } else if (hi >= 0xE0) {
+      d = int64_t(kPhysBase) - 0xE0000000ll + 0x1000;
+    }
+    t.d[hi] = d;
+  }
+  return t;
+}
+
+inline constexpr DeltaTable kDeltaTable = MakeDeltaTable();
+
+// Guest address -> host offset from the virtual membase.
+constexpr uint64_t HostOffset(uint32_t a) noexcept {
+  return uint64_t(int64_t(a) + kDeltaTable.d[a >> 24]);
+}
+
+inline bool IsMmioWindow(uint32_t a) noexcept { return uint32_t(a - kMmioWindowBase) < kMmioWindowSize; }
+
+inline bool PageBit(const uint8_t* base, uint64_t table_offset, uint64_t page) noexcept {
+  const uint64_t* bm = reinterpret_cast<const uint64_t*>(base + table_offset);
+  return (bm[page >> 6] >> (page & 63)) & 1;
+}
+
+// True when a store of `len` bytes at host offset `off` touches a watched physical page.
+inline bool StoreHitsWatch(const uint8_t* base, uint64_t off, uint32_t len) noexcept {
+  if (off < kPhysBase) {
+    return false;
+  }
+  const uint64_t p0 = (off - kPhysBase) >> kPageShift;
+  const uint64_t p1 = (off + len - 1 - kPhysBase) >> kPageShift;
+  return PageBit(base, kWatchBitmapOffset, p0) | PageBit(base, kWatchBitmapOffset, p1);
+}
+
+// Sets the sticky dirty bit of every physical host page a `len`-byte store at guest `a` touches.
+// Shared by the runtime (Memory::NxWatchHit) and the unit test.
+inline void MarkDirty(uint8_t* base, uint32_t a, uint32_t len) noexcept {
+  const uint64_t off = HostOffset(a);
+  if (off < kPhysBase || !len) {
+    return;
+  }
+  uint64_t* dirty = reinterpret_cast<uint64_t*>(base + kDirtyBitmapOffset);
+  const uint64_t rel = off - kPhysBase;
+  for (uint64_t p = rel >> kPageShift; p <= ((rel + len - 1) >> kPageShift) && p < kBitmapPages; ++p) {
+    __atomic_fetch_or(&dirty[p >> 6], uint64_t(1) << (p & 63), __ATOMIC_RELAXED);
+  }
+}
+
+// Runtime slow path (rexruntime, xmemory.cpp). Marks the dirty bitmap for the touched pages and
+// runs the physical-memory invalidation callbacks of every alias heap watching them.
+void WatchHit(uint32_t guest_address, uint32_t length);
+// Runtime MMIO slow paths: true if a registered MMIO range claimed the access.
+bool MmioLoad(uint32_t guest_address, uint32_t* out_value);
+bool MmioStore(uint32_t guest_address, uint32_t value);
+
+}  // namespace rex::nxmem
