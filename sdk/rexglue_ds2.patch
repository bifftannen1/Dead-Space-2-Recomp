+// Writes the whole VkPipelineCache to p4_vk_pipeline_cache_path. DS2: rewriting it after every
+// pipeline cost ~24 ms each (5 MB file, 233 pipelines in a startup burst) under a lock the
+// creation threads share, and the title hard-exits so Shutdown never runs. Creations now only
+// mark the cache dirty; a background thread writes it at most every 10 s.
+std::atomic<bool> g_p4_dirty{false};
+std::atomic<bool> g_p4_stop{false};
+size_t P4SaveCache(const ui::vulkan::VulkanDevice* vd) {
+  const std::string& path = REXCVAR_GET(p4_vk_pipeline_cache_path);
+  P4PipelineCache& c = p4_pcache();
+  if (path.empty() || c.cache == VK_NULL_HANDLE) return 0;
+  std::vector<uint8_t> d;
+  {
+    std::lock_guard<std::mutex> lock(c.mutex);
+    size_t n = 0;
+    auto get = P4Proc<PFN_vkGetPipelineCacheData>(vd, "vkGetPipelineCacheData");
+    if (!get || get(vd->device(), c.cache, &n, nullptr) != VK_SUCCESS || !n) return 0;
+    d.resize(n);
+    if (get(vd->device(), c.cache, &n, d.data()) != VK_SUCCESS) return 0;
+    d.resize(n);
+  }
+  // Write to a temp file and rename, so a kill mid-write never leaves a torn cache.
+  const std::string tmp = path + ".tmp";
+  size_t saved = 0;
+  if (FILE* f = std::fopen(tmp.c_str(), "wb")) {
+    saved = std::fwrite(d.data(), 1, d.size(), f);
+    std::fclose(f);
+  }
+  std::error_code ec;
+  if (saved == d.size()) std::filesystem::rename(tmp, path, ec);
+  REXGPU_INFO("P4_PCACHE_SAVE bytes={} ok={}", saved, saved == d.size() && !ec);
+  return saved;
+}
+void P4StartSaver(const ui::vulkan::VulkanDevice* vd) {
+  static std::once_flag once;
+  std::call_once(once, [vd] {
+    std::thread([vd] {
+      for (;;) {
+        std::this_thread::sleep_for(std::chrono::seconds(10));
+        if (g_p4_stop) return;
+        if (g_p4_dirty.exchange(false)) P4SaveCache(vd);
+      }
+    }).detach();
+  });
+}
