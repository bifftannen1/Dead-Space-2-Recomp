new file mode 100644
index 0000000..ca1e693
--- /dev/null
+++ b/src/core/mapped_memory_nx.cpp
@@ -0,0 +1,139 @@
+/**
+ * @file        core/mapped_memory_nx.cpp
+ * @brief       Horizon (NX) read-only file mapping: reserved region + explicit Prefetch (N2)
+ *
+ * Horizon has no file mmap and cannot resume from a fault, so a mapping is a reserved
+ * nn::os address region the size of the file; Prefetch(offset, length) commits the 256 KB
+ * chunks covering the range (AllocateMemoryPages) and fills them with nn::fs::ReadFile.
+ * Every reader of data() on NX calls Prefetch first (disc_image_* NX branches).
+ * Resident chunks stay resident (no eviction yet: memory grows with the bytes the game reads;
+ * N2 NOTES "not done").  Only Mode::kRead is supported; kReadWrite returns nullptr.
+ */
+
+#include <rex/platform.h>
+static_assert(REX_PLATFORM_NX, "This file is Horizon-only");
+
+#include <rex/memory/mapped_memory.h>
+
+#include <nn/fs.h>
+#include <nn/os/os_VirtualAddressMemoryApi.h>
+
+#include <algorithm>
+#include <cstdio>
+#include <mutex>
+#include <vector>
+
+namespace rex::memory {
+
+namespace {
+constexpr size_t kChunk = 256 * 1024;
+
+class NxMappedMemory final : public MappedMemory {
+ public:
+  NxMappedMemory(nn::fs::FileHandle h, uintptr_t region, size_t region_size, size_t file_size,
+                 size_t offset, size_t length)
+      : MappedMemory(reinterpret_cast<void*>(region), length),
+        handle_(h), region_(region), region_size_(region_size), file_size_(file_size),
+        offset_(offset), resident_((region_size + kChunk - 1) / kChunk, 0) {}
+
+  ~NxMappedMemory() override { Close(); }
+
+  void Close(uint64_t) override { Close(); }
+
+  bool Prefetch(size_t offset, size_t length) override {
+    if (!region_) return false;
+    if (length == 0) return true;
+    if (offset + length > size_) return false;
+    std::lock_guard<std::mutex> lock(mutex_);
+    size_t c0 = offset / kChunk, c1 = (offset + length + kChunk - 1) / kChunk;
+    for (size_t c = c0; c < c1; ++c) {
+      if (resident_[c]) continue;
+      const uintptr_t at = region_ + c * kChunk;
+      const size_t clen = std::min(kChunk, region_size_ - c * kChunk);
+      nn::Result r = nn::os::AllocateMemoryPages(at, clen);
+      if (r.IsFailure()) {
+        std::fprintf(stderr, "mapped_memory_nx: AllocateMemoryPages failed 0x%08x\n",
+                     r.GetInnerValueForDebug());
+        return false;
+      }
+      const size_t foff = offset_ + c * kChunk;
+      const size_t want = foff < file_size_ ? std::min(clen, file_size_ - foff) : 0;
+      size_t got = 0;
+      if (want) {
+        r = nn::fs::ReadFile(&got, handle_, int64_t(foff), reinterpret_cast<void*>(at), want);
+        if (r.IsFailure() || got != want) {
+          std::fprintf(stderr, "mapped_memory_nx: ReadFile(0x%zx, 0x%zx) failed 0x%08x got 0x%zx\n",
+                       foff, want, r.GetInnerValueForDebug(), got);
+          nn::os::FreeMemoryPages(at, clen);
+          return false;
+        }
+      }
+      resident_[c] = 1;
+      resident_bytes_ += clen;
+    }
+    return true;
+  }
+
+ private:
+  void Close() {
+    if (!region_) return;
+    for (size_t c = 0; c < resident_.size(); ++c) {
+      if (resident_[c]) {
+        nn::os::FreeMemoryPages(region_ + c * kChunk, std::min(kChunk, region_size_ - c * kChunk));
+      }
+    }
+    nn::os::FreeAddressRegion(region_);
+    nn::fs::CloseFile(handle_);
+    region_ = 0;
+    data_ = nullptr;
+  }
+
+  nn::fs::FileHandle handle_;
+  uintptr_t region_;
+  size_t region_size_;
+  size_t file_size_;
+  size_t offset_;
+  std::vector<uint8_t> resident_;
+  size_t resident_bytes_ = 0;
+  std::mutex mutex_;
+};
+}  // namespace
+
+std::unique_ptr<MappedMemory> MappedMemory::Open(const std::filesystem::path& path, Mode mode,
+                                                 size_t offset, size_t length) {
+  if (mode != Mode::kRead) {
+    std::fprintf(stderr, "mapped_memory_nx: read-write mapping unsupported (%s)\n", path.c_str());
+    return nullptr;
+  }
+  nn::fs::FileHandle h;
+  if (nn::fs::OpenFile(&h, path.c_str(), nn::fs::OpenMode_Read).IsFailure()) {
+    return nullptr;
+  }
+  int64_t fsize = 0;
+  if (nn::fs::GetFileSize(&fsize, h).IsFailure() || size_t(fsize) < offset) {
+    nn::fs::CloseFile(h);
+    return nullptr;
+  }
+  const size_t len = length ? std::min(length, size_t(fsize) - offset) : size_t(fsize) - offset;
+  const size_t region_size = std::max<size_t>((len + kChunk - 1) / kChunk * kChunk, kChunk);
+  uintptr_t region = 0;
+  nn::Result r = nn::os::AllocateAddressRegion(&region, region_size);
+  if (r.IsFailure()) {
+    std::fprintf(stderr, "mapped_memory_nx: AllocateAddressRegion(0x%zx) failed 0x%08x\n",
+                 region_size, r.GetInnerValueForDebug());
+    nn::fs::CloseFile(h);
+    return nullptr;
+  }
+  return std::unique_ptr<MappedMemory>(
+      new NxMappedMemory(h, region, region_size, size_t(fsize), offset, len));
+}
+
+std::unique_ptr<ChunkedMappedMemoryWriter> ChunkedMappedMemoryWriter::Open(
+    const std::filesystem::path& path, size_t chunk_size, bool low_address_space) {
+  (void)path;
+  (void)chunk_size;
+  (void)low_address_space;
+  return nullptr;
+}
+
+}  // namespace rex::memory
diff --git a/src/core/memory_nx.cpp b/src/core/memory_nx.cpp
new file mode 100644
index 0000000..245219c
--- /dev/null
+++ b/src/core/memory_nx.cpp
@@ -0,0 +1,230 @@
+/**
+ * @file        core/memory_nx.cpp
+ * @brief       Horizon (NX) host memory: nn::os virtual-address memory (N2, 2026-10-06)
+ *
+ * Model (docs/audit/s4-horizon-design-2026-10-06/DESIGN.md (a), S4b REX_NX_MEMORY_MODEL):
+ *  - CreateFileMappingHandle reserves ONE address region (nn::os::AllocateAddressRegion) of the
+ *    requested size; Horizon chooses the address. A file mapping is never shared twice: the S4b
+ *    model maps only the canonical views and translates every mirror.
+ *  - MapFileView(handle, nullptr, ...) returns region base + offset (how xmemory.cpp's NX branch
+ *    learns the base); MapFileView(handle, p, ...) accepts only p == base + offset (the canonical
+ *    view) and commits nothing.
+ *  - AllocFixed(kCommit) inside a region commits the missing pages with AllocateMemoryPages
+ *    (page bitmap per region, so re-commit is idempotent); AllocFixed(nullptr) creates a private
+ *    region. DeallocFixed(kDecommit) frees pages; kRelease of a region base frees the region.
+ *  - Protect/QueryProtect record the requested access per page but do NOT change the hardware
+ *    permission: write-watch is software in the S4b model and the MMIO window is a range check,
+ *    so nothing depends on a fault (Horizon cannot resume from one).  Read-only guest pages are
+ *    therefore writable on NX; recorded in docs/audit/n2-horizon-2026-10-06/NOTES.md.
+ */
+
+#include <rex/platform.h>
+static_assert(REX_PLATFORM_NX, "This file is Horizon-only");
+
+#include <rex/memory.h>
+
+#include <nn/nn_Result.h>
+#include <nn/os/os_VirtualAddressMemoryApi.h>
+
+#include <algorithm>
+#include <cstdio>
+#include <cstring>
+#include <mutex>
+#include <vector>
+
+namespace rex::memory {
+
+namespace {
+constexpr size_t kPage = 4096;
+
+struct Region {
+  uintptr_t base = 0;
+  size_t size = 0;
+  std::vector<uint64_t> committed;  // 1 bit per page
+  std::vector<uint8_t> access;      // recorded PageAccess per page
+  bool is_mapping = false;
+  bool live = false;
+};
+
+std::mutex g_mutex;
+std::vector<Region> g_regions;
+
+Region* Find(uintptr_t p) {
+  for (auto& r : g_regions) {
+    if (r.live && p >= r.base && p < r.base + r.size) return &r;
+  }
+  return nullptr;
+}
+
+intptr_t NewRegion(size_t size, bool is_mapping) {
+  size = (size + kPage - 1) & ~(kPage - 1);
+  uintptr_t addr = 0;
+  nn::Result res = nn::os::AllocateAddressRegion(&addr, size);
+  if (res.IsFailure()) {
+    std::fprintf(stderr, "memory_nx: AllocateAddressRegion(0x%zx) failed 0x%08x\n", size,
+                 res.GetInnerValueForDebug());
+    return -1;
+  }
+  Region r;
+  r.base = addr;
+  r.size = size;
+  r.committed.assign((size / kPage + 63) / 64, 0);
+  r.access.assign(size / kPage, uint8_t(PageAccess::kNoAccess));
+  r.is_mapping = is_mapping;
+  r.live = true;
+  for (size_t i = 0; i < g_regions.size(); ++i) {
+    if (!g_regions[i].live) {
+      g_regions[i] = std::move(r);
+      return intptr_t(i);
+    }
+  }
+  g_regions.push_back(std::move(r));
+  return intptr_t(g_regions.size() - 1);
+}
+
+bool Bit(const Region& r, size_t pg) { return (r.committed[pg >> 6] >> (pg & 63)) & 1; }
+void SetBit(Region& r, size_t pg, bool v) {
+  if (v) r.committed[pg >> 6] |= 1ull << (pg & 63);
+  else r.committed[pg >> 6] &= ~(1ull << (pg & 63));
+}
+
+bool Commit(Region& r, uintptr_t p, size_t len, PageAccess access) {
+  size_t p0 = (p - r.base) / kPage, p1 = (p - r.base + len + kPage - 1) / kPage;
+  size_t i = p0;
+  while (i < p1) {
+    if (Bit(r, i)) { r.access[i] = uint8_t(access); ++i; continue; }
+    size_t j = i;
+    while (j < p1 && !Bit(r, j)) ++j;
+    nn::Result res = nn::os::AllocateMemoryPages(r.base + i * kPage, (j - i) * kPage);
+    if (res.IsFailure()) {
+      std::fprintf(stderr, "memory_nx: AllocateMemoryPages(0x%zx, 0x%zx) failed 0x%08x\n",
+                   size_t(r.base + i * kPage), (j - i) * kPage, res.GetInnerValueForDebug());
+      return false;
+    }
+    for (size_t k = i; k < j; ++k) { SetBit(r, k, true); r.access[k] = uint8_t(access); }
+    i = j;
+  }
+  return true;
+}
+
+bool Decommit(Region& r, uintptr_t p, size_t len) {
+  size_t p0 = (p - r.base) / kPage, p1 = (p - r.base + len + kPage - 1) / kPage;
+  size_t i = p0;
+  while (i < p1) {
+    if (!Bit(r, i)) { ++i; continue; }
+    size_t j = i;
+    while (j < p1 && Bit(r, j)) ++j;
+    if (nn::os::FreeMemoryPages(r.base + i * kPage, (j - i) * kPage).IsFailure()) return false;
+    for (size_t k = i; k < j; ++k) { SetBit(r, k, false); r.access[k] = uint8_t(PageAccess::kNoAccess); }
+    i = j;
+  }
+  return true;
+}
+}  // namespace
+
+size_t page_size() { return kPage; }
+size_t allocation_granularity() { return kPage; }
+bool IsWritableExecutableMemorySupported() { return false; }
+
+void* AllocFixed(void* base_address, size_t length, AllocationType allocation_type,
+                 PageAccess access) {
+  std::lock_guard<std::mutex> lock(g_mutex);
+  const bool commit = (uint32_t(allocation_type) & uint32_t(AllocationType::kCommit)) != 0;
+  if (!base_address) {
+    intptr_t h = NewRegion(length, false);
+    if (h < 0) return nullptr;
+    Region& r = g_regions[size_t(h)];
+    if (commit && !Commit(r, r.base, length, access)) return nullptr;
+    return reinterpret_cast<void*>(r.base);
+  }
+  uintptr_t p = reinterpret_cast<uintptr_t>(base_address);
+  Region* r = Find(p);
+  if (!r || p + length > r->base + r->size) {
+    std::fprintf(stderr, "memory_nx: AllocFixed(%p, 0x%zx) outside every reserved region\n",
+                 base_address, length);
+    return nullptr;
+  }
+  if (commit && !Commit(*r, p, length, access)) return nullptr;
+  return base_address;
+}
+
+bool DeallocFixed(void* base_address, size_t length, DeallocationType deallocation_type) {
+  std::lock_guard<std::mutex> lock(g_mutex);
+  uintptr_t p = reinterpret_cast<uintptr_t>(base_address);
+  Region* r = Find(p);
+  if (!r) return false;
+  if (deallocation_type == DeallocationType::kRelease && p == r->base && !r->is_mapping) {
+    Decommit(*r, r->base, r->size);
+    nn::os::FreeAddressRegion(r->base);
+    r->live = false;
+    return true;
+  }
+  if (length == 0) length = r->base + r->size - p;
+  return Decommit(*r, p, length);
+}
+
+bool Protect(void* base_address, size_t length, PageAccess access, PageAccess* out_old_access) {
+  std::lock_guard<std::mutex> lock(g_mutex);
+  uintptr_t p = reinterpret_cast<uintptr_t>(base_address);
+  Region* r = Find(p);
+  if (!r) return false;
+  size_t p0 = (p - r->base) / kPage, p1 = std::min(r->size / kPage, (p - r->base + length + kPage - 1) / kPage);
+  if (out_old_access) *out_old_access = PageAccess(r->access[p0]);
+  for (size_t i = p0; i < p1; ++i) r->access[i] = uint8_t(access);
+  return true;
+}
+
+bool QueryProtect(void* base_address, size_t& length, PageAccess& access_out) {
+  std::lock_guard<std::mutex> lock(g_mutex);
+  uintptr_t p = reinterpret_cast<uintptr_t>(base_address);
+  Region* r = Find(p);
+  if (!r) { length = 0; access_out = PageAccess::kNoAccess; return false; }
+  size_t p0 = (p - r->base) / kPage, n = r->size / kPage, i = p0;
+  while (i < n && r->access[i] == r->access[p0]) ++i;
+  length = (i - p0) * kPage;
+  access_out = PageAccess(r->access[p0]);
+  return true;
+}
+
+FileMappingHandle CreateFileMappingHandle(const std::filesystem::path& path, size_t length,
+                                          PageAccess access, bool commit) {
+  (void)path;
+  std::lock_guard<std::mutex> lock(g_mutex);
+  intptr_t h = NewRegion(length, true);
+  if (h < 0) return kFileMappingHandleInvalid;
+  if (commit && !Commit(g_regions[size_t(h)], g_regions[size_t(h)].base, length, access)) {
+    return kFileMappingHandleInvalid;
+  }
+  return FileMappingHandle(h);
+}
+
+void CloseFileMappingHandle(FileMappingHandle handle, const std::filesystem::path& path) {
+  (void)path;
+  std::lock_guard<std::mutex> lock(g_mutex);
+  if (handle < 0 || size_t(handle) >= g_regions.size() || !g_regions[size_t(handle)].live) return;
+  Region& r = g_regions[size_t(handle)];
+  Decommit(r, r.base, r.size);
+  nn::os::FreeAddressRegion(r.base);
+  r.live = false;
+}
+
+void* MapFileView(FileMappingHandle handle, void* base_address, size_t length, PageAccess access,
+                  size_t file_offset) {
+  (void)access;
+  std::lock_guard<std::mutex> lock(g_mutex);
+  if (handle < 0 || size_t(handle) >= g_regions.size() || !g_regions[size_t(handle)].live) return nullptr;
+  Region& r = g_regions[size_t(handle)];
+  if (file_offset + length > r.size) return nullptr;
+  uintptr_t want = r.base + file_offset;
+  if (base_address && reinterpret_cast<uintptr_t>(base_address) != want) return nullptr;
+  return reinterpret_cast<void*>(want);
+}
+
+bool UnmapFileView(FileMappingHandle handle, void* base_address, size_t length) {
+  (void)handle;
+  (void)base_address;
+  (void)length;
+  return true;  // views are windows of the one region; the region is freed by CloseFileMappingHandle
+}
+
+}  // namespace rex::memory
