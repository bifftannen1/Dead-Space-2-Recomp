+/**
+ * @file        rex/input/nx/nx_hid_input_driver_nx.h
+ * @brief       Horizon (NX) input driver on nn::hid Npad (P6, 2026-10-06)
+ *
+ * One controller device for guest user 0: Npad No1 (full-key / Pro Controller, or dual Joy-Con)
+ * merged with Npad Handheld.  Buttons are mapped by position to the Xbox 360 layout (Switch B,
+ * the bottom face button, is XInput A; Switch A is XInput B; X->Y; Y->X), +/- are START/BACK,
+ * L/R the shoulders, ZL/ZR full-scale triggers, stick clicks the thumb buttons, sticks pass through
+ * (both APIs are +-0x7FFF, y up).  CreateDefaultInputSystem's NX branch calls
+ * CreateNxHidInputDriver() (declared weak there, so a link without this unit keeps the NOP input).
+ */
+
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+#include <memory>
+
+#include <rex/input/input_driver.h>
+
+namespace rex::input::nx {
+
+struct NxHidStats {
+  std::atomic<uint64_t> polls{0};          // GetDeviceState calls (XamInputGetState path)
+  std::atomic<uint64_t> nonzero_polls{0};  // polls returning any button/trigger/stick
+  std::atomic<uint32_t> last_nonzero_buttons{0};
+  std::atomic<uint32_t> or_buttons{0};     // OR of every XInput button word returned
+  std::atomic<uint32_t> styles_no1{0};
+  std::atomic<uint32_t> styles_handheld{0};
+};
+
+NxHidStats& GetNxHidStats();
+
+std::unique_ptr<InputDriver> CreateNxHidInputDriver();
+
+}  // namespace rex::input::nx
