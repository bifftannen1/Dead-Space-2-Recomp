new file mode 100644
index 0000000..ba85ac3
--- /dev/null
+++ b/src/input/nx/nx_hid_input_driver_nx.cpp
@@ -0,0 +1,174 @@
+/**
+ * @file        input/nx/nx_hid_input_driver_nx.cpp
+ * @brief       Horizon (NX) nn::hid Npad input driver (P6, 2026-10-06) - see the header.
+ */
+
+#include <rex/input/input.h>
+#include <rex/input/nx/nx_hid_input_driver_nx.h>
+#include <rex/logging.h>
+
+#include <nn/hid.h>
+#include <nn/hid/hid_Npad.h>
+#include <nn/hid/hid_NpadFullKey.h>
+#include <nn/hid/hid_NpadHandheld.h>
+#include <nn/hid/hid_NpadJoyDual.h>
+
+#include <cstdlib>
+#include <cstring>
+
+namespace rex::input::nx {
+
+NxHidStats& GetNxHidStats() {
+  static NxHidStats s;
+  return s;
+}
+
+namespace {
+constexpr DeviceId kNxPad = static_cast<DeviceId>(0x4E584844);  // "NXHD"
+constexpr nn::hid::NpadIdType kIds[] = {nn::hid::NpadId::No1, nn::hid::NpadId::Handheld};
+
+struct Raw {
+  nn::hid::NpadButtonSet buttons;
+  int32_t lx = 0, ly = 0, rx = 0, ry = 0;
+};
+
+template <typename State>
+void Accumulate(Raw& acc, const nn::hid::NpadIdType& id) {
+  State s;
+  nn::hid::GetNpadState(&s, id);
+  acc.buttons |= s.buttons;
+  auto pick = [](int32_t& dst, int32_t v) {
+    if (std::abs(v) > std::abs(dst)) dst = v;
+  };
+  pick(acc.lx, s.analogStickL.x);
+  pick(acc.ly, s.analogStickL.y);
+  pick(acc.rx, s.analogStickR.x);
+  pick(acc.ry, s.analogStickR.y);
+}
+
+int16_t Axis(int32_t v) {
+  if (v > 0x7FFF) v = 0x7FFF;
+  if (v < -0x7FFF) v = -0x7FFF;
+  return int16_t(v);
+}
+
+class NxHidInputDriver final : public InputDriver {
+ public:
+  NxHidInputDriver() : InputDriver(nullptr, 0) {}
+
+  X_STATUS Setup() override {
+    nn::hid::InitializeNpad();
+    nn::hid::SetSupportedNpadStyleSet(nn::hid::NpadStyleFullKey::Mask |
+                                      nn::hid::NpadStyleHandheld::Mask |
+                                      nn::hid::NpadStyleJoyDual::Mask);
+    nn::hid::SetSupportedNpadIdType(kIds, sizeof(kIds) / sizeof(kIds[0]));
+    REXLOG_INFO("NxHid: Npad No1 + Handheld (FullKey|Handheld|JoyDual)");
+    return X_STATUS_SUCCESS;
+  }
+
+  void EnumerateDevices(std::vector<DeviceInfo>& out) override {
+    DeviceInfo info;
+    info.id = kNxPad;
+    info.name = "NX Npad";
+    info.guid = "nx-npad-no1-handheld";
+    info.synthetic = false;
+    out.push_back(info);
+  }
+
+  X_RESULT GetDeviceState(DeviceId id, X_INPUT_STATE* out_state) override {
+    if (id != kNxPad) return X_ERROR_DEVICE_NOT_CONNECTED;
+    auto& st = GetNxHidStats();
+    Raw r;
+    r.buttons.Reset();  // BitFlagSet is POD: uninitialised storage read as all buttons held (Eden run a1: pad_or=F3FF on every poll)
+    const auto s1 = nn::hid::GetNpadStyleSet(nn::hid::NpadId::No1);
+    const auto sh = nn::hid::GetNpadStyleSet(nn::hid::NpadId::Handheld);
+    st.styles_no1 = uint32_t(s1._storage[0]);
+    st.styles_handheld = uint32_t(sh._storage[0]);
+    if (s1.Test<nn::hid::NpadStyleFullKey>()) Accumulate<nn::hid::NpadFullKeyState>(r, nn::hid::NpadId::No1);
+    if (s1.Test<nn::hid::NpadStyleJoyDual>()) Accumulate<nn::hid::NpadJoyDualState>(r, nn::hid::NpadId::No1);
+    if (sh.Test<nn::hid::NpadStyleHandheld>())
+      Accumulate<nn::hid::NpadHandheldState>(r, nn::hid::NpadId::Handheld);
+
+    using B = nn::hid::NpadButton;
+    uint16_t xb = 0;
+    auto map = [&](bool on, uint16_t bit) {
+      if (on) xb |= bit;
+    };
+    map(r.buttons.Test<B::B>(), X_INPUT_GAMEPAD_A);
+    map(r.buttons.Test<B::A>(), X_INPUT_GAMEPAD_B);
+    map(r.buttons.Test<B::Y>(), X_INPUT_GAMEPAD_X);
+    map(r.buttons.Test<B::X>(), X_INPUT_GAMEPAD_Y);
+    map(r.buttons.Test<B::Plus>(), X_INPUT_GAMEPAD_START);
+    map(r.buttons.Test<B::Minus>(), X_INPUT_GAMEPAD_BACK);
+    map(r.buttons.Test<B::L>(), X_INPUT_GAMEPAD_LEFT_SHOULDER);
+    map(r.buttons.Test<B::R>(), X_INPUT_GAMEPAD_RIGHT_SHOULDER);
+    map(r.buttons.Test<B::StickL>(), X_INPUT_GAMEPAD_LEFT_THUMB);
+    map(r.buttons.Test<B::StickR>(), X_INPUT_GAMEPAD_RIGHT_THUMB);
+    map(r.buttons.Test<B::Up>(), X_INPUT_GAMEPAD_DPAD_UP);
+    map(r.buttons.Test<B::Down>(), X_INPUT_GAMEPAD_DPAD_DOWN);
+    map(r.buttons.Test<B::Left>(), X_INPUT_GAMEPAD_DPAD_LEFT);
+    map(r.buttons.Test<B::Right>(), X_INPUT_GAMEPAD_DPAD_RIGHT);
+
+    if (out_state) {
+      std::memset(out_state, 0, sizeof(*out_state));
+      out_state->packet_number = uint32_t(++packet_);
+      out_state->gamepad.buttons = xb;
+      out_state->gamepad.left_trigger = r.buttons.Test<B::ZL>() ? 0xFF : 0;
+      out_state->gamepad.right_trigger = r.buttons.Test<B::ZR>() ? 0xFF : 0;
+      out_state->gamepad.thumb_lx = Axis(r.lx);
+      out_state->gamepad.thumb_ly = Axis(r.ly);
+      out_state->gamepad.thumb_rx = Axis(r.rx);
+      out_state->gamepad.thumb_ry = Axis(r.ry);
+    }
+    st.polls.fetch_add(1);
+    const bool any = xb || r.buttons.Test<B::ZL>() || r.buttons.Test<B::ZR>() || r.lx || r.ly ||
+                     r.rx || r.ry;
+    if (any) {
+      st.nonzero_polls.fetch_add(1);
+      st.last_nonzero_buttons = xb;
+      st.or_buttons.fetch_or(xb);
+    }
+    return X_ERROR_SUCCESS;
+  }
+
+  X_RESULT GetDeviceCapabilities(DeviceId id, uint32_t flags,
+                                 X_INPUT_CAPABILITIES* out_caps) override {
+    (void)flags;
+    if (id != kNxPad) return X_ERROR_DEVICE_NOT_CONNECTED;
+    if (out_caps) {
+      std::memset(out_caps, 0, sizeof(*out_caps));
+      out_caps->type = 0x01;      // XINPUT_DEVTYPE_GAMEPAD
+      out_caps->sub_type = 0x01;  // XINPUT_DEVSUBTYPE_GAMEPAD
+      out_caps->gamepad.buttons = 0xF3FF;  // as the SDL driver, no guide
+      out_caps->gamepad.left_trigger = 0xFF;
+      out_caps->gamepad.right_trigger = 0xFF;
+      out_caps->gamepad.thumb_lx = static_cast<int16_t>(0xFFFFu);
+      out_caps->gamepad.thumb_ly = static_cast<int16_t>(0xFFFFu);
+      out_caps->gamepad.thumb_rx = static_cast<int16_t>(0xFFFFu);
+      out_caps->gamepad.thumb_ry = static_cast<int16_t>(0xFFFFu);
+    }
+    return X_ERROR_SUCCESS;
+  }
+
+  X_RESULT SetDeviceVibration(DeviceId id, X_INPUT_VIBRATION* vibration) override {
+    (void)vibration;  // nn::hid vibration not wired (open item)
+    return id == kNxPad ? X_ERROR_SUCCESS : X_ERROR_DEVICE_NOT_CONNECTED;
+  }
+
+  X_RESULT GetDeviceKeystroke(DeviceId id, uint32_t flags,
+                              X_INPUT_KEYSTROKE* out_keystroke) override {
+    (void)flags;
+    (void)out_keystroke;
+    return id == kNxPad ? X_ERROR_EMPTY : X_ERROR_DEVICE_NOT_CONNECTED;
+  }
+
+ private:
+  uint64_t packet_ = 0;
+};
+}  // namespace
+
+std::unique_ptr<InputDriver> CreateNxHidInputDriver() {
+  return std::make_unique<NxHidInputDriver>();
+}
+
+}  // namespace rex::input::nx
