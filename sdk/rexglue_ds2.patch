index 0000000..c347ee6
--- /dev/null
+++ b/src/ui/window_nx.cpp
@@ -0,0 +1,129 @@
+/**
+ * @file        ui/window_nx.cpp
+ * @brief       Horizon (NX) window: nn::vi layer + UI loop (N2, 2026-10-06)
+ *
+ * Replaces window_sdl/windowed_app_context_sdl on NX. The window is the application's one nn::vi
+ * layer on the default display (1280x720, the layer's default size); its surface is a ViNNSurface
+ * (VK_NN_vi_surface).  Paint requests are coalesced and run on the UI thread through the app
+ * context. No input events here (nn::hid is the input layer's job).
+ */
+
+#include <rex/platform.h>
+static_assert(REX_PLATFORM_NX, "This file is Horizon-only");
+
+#include <rex/logging.h>
+#include <rex/ui/surface_nx.h>
+#include <rex/ui/window.h>
+#include <rex/ui/windowed_app_context_nx.h>
+
+#include <nn/vi.h>
+
+#include <atomic>
+#include <chrono>
+
+namespace rex::ui {
+
+NXWindowedAppContext::~NXWindowedAppContext() = default;
+
+void NXWindowedAppContext::NotifyUILoopOfPendingFunctions() {
+  {
+    std::lock_guard<std::mutex> lock(mutex_);
+    pending_ = true;
+  }
+  cv_.notify_one();
+}
+
+void NXWindowedAppContext::PlatformQuitFromUIThread() {
+  std::lock_guard<std::mutex> lock(mutex_);
+  quit_ = true;
+}
+
+void NXWindowedAppContext::RunMainLoop() {
+  for (;;) {
+    {
+      std::unique_lock<std::mutex> lock(mutex_);
+      cv_.wait_for(lock, std::chrono::milliseconds(16), [this] { return pending_ || quit_; });
+      pending_ = false;
+      if (quit_) return;
+    }
+    ExecutePendingFunctionsFromUIThread();
+    if (HasQuitFromUIThread()) return;
+  }
+}
+
+namespace {
+constexpr uint32_t kLayerWidth = 1280;
+constexpr uint32_t kLayerHeight = 720;
+}  // namespace
+
+class WindowNX final : public Window {
+ public:
+  WindowNX(WindowedAppContext& app_context, const std::string_view title, uint32_t w, uint32_t h)
+      : Window(app_context, title, w, h) {}
+  ~WindowNX() override {
+    EnterDestructor();
+    if (layer_) nn::vi::DestroyLayer(layer_);
+    if (display_) nn::vi::CloseDisplay(display_);
+  }
+  void* GetNativeWindowHandle() const override { return native_window_; }
+
+ protected:
+  bool OpenImpl() override {
+    static bool vi_initialized = false;
+    if (!vi_initialized) {
+      nn::vi::Initialize();
+      vi_initialized = true;
+    }
+    if (nn::vi::OpenDefaultDisplay(&display_).IsFailure()) {
+      REXLOG_ERROR("WindowNX: nn::vi::OpenDefaultDisplay failed");
+      return false;
+    }
+    if (nn::vi::CreateLayer(&layer_, display_).IsFailure()) {
+      REXLOG_ERROR("WindowNX: nn::vi::CreateLayer failed");
+      return false;
+    }
+    nn::vi::NativeWindowHandle nw = nullptr;
+    if (nn::vi::GetNativeWindow(&nw, layer_).IsFailure() || !nw) {
+      REXLOG_ERROR("WindowNX: nn::vi::GetNativeWindow failed");
+      return false;
+    }
+    native_window_ = nw;
+    WindowDestructionReceiver destruction_receiver(this);
+    OnActualSizeUpdate(kLayerWidth, kLayerHeight, destruction_receiver);
+    if (destruction_receiver.IsWindowDestroyed()) return true;
+    OnFocusUpdate(true, destruction_receiver);
+    REXLOG_INFO("WindowNX: nn::vi layer open ({}x{})", kLayerWidth, kLayerHeight);
+    return true;
+  }
+
+  void RequestCloseImpl() override {}
+
+  std::unique_ptr<Surface> CreateSurfaceImpl(Surface::TypeFlags allowed_types) override {
+    if (!native_window_ || !(allowed_types & Surface::kTypeFlag_ViNN)) return nullptr;
+    return std::make_unique<ViNNSurface>(native_window_, kLayerWidth, kLayerHeight);
+  }
+
+  void RequestPaintImpl() override {
+    if (paint_pending_.exchange(true, std::memory_order_acq_rel)) return;
+    app_context().CallInUIThreadDeferred([this] {
+      paint_pending_.store(false, std::memory_order_release);
+      OnPaint();
+    });
+  }
+
+ private:
+  nn::vi::Display* display_ = nullptr;
+  nn::vi::Layer* layer_ = nullptr;
+  void* native_window_ = nullptr;
+  std::atomic<bool> paint_pending_{false};
+};
+
+std::unique_ptr<Window> Window::Create(WindowedAppContext& app_context,
+                                       const std::string_view title,
+                                       uint32_t desired_logical_width,
+                                       uint32_t desired_logical_height) {
+  return std::make_unique<WindowNX>(app_context, title, desired_logical_width,
+                                    desired_logical_height);
+}
+
+}  // namespace rex::ui
