+void Memory::NxSyncWatchBits(uint64_t page_first, uint64_t page_last) {
+  uint64_t* bm = nx_watch_bitmap();
+  PhysicalHeap* hs[3] = {&heaps_.vA0000000, &heaps_.vC0000000, &heaps_.vE0000000};
+  for (uint64_t p = page_first; p <= page_last && p < rex::nxmem::kBitmapPages; ++p) {
+    bool watched = false;
+    for (PhysicalHeap* h : hs) {
+      BaseHeap* b = h;
+      const int64_t bias =
