+// P3 table: "P3SPVTB1", u32 version (1), u32 count, u64 profile XXH3_64 (of the translator-inputs text),
+// u8[32] translator exe sha256; then count x {u64 ucode_hash, u64 modification, u32 spirv_offset,
+// u32 spirv_size, u32 texture_count, u32 sampler_count, u32 records_offset}; offsets from file start.
+struct P3Entry {
+  uint32_t spirv_offset, spirv_size, texture_count, sampler_count, records_offset;
+};
+struct P3Table {
+  bool active = false;
+  std::vector<uint8_t> file;  // header + index only; blobs are read on a hit (NX memory budget)
+  FILE* fp = nullptr;
+  std::mutex fp_mutex;
+  uint64_t file_size = 0;
+  std::unordered_map<uint64_t, std::unordered_map<uint64_t, P3Entry>> entries;
+  std::atomic<uint64_t> hits{0}, misses{0};
+};
+P3Table& p3_table() {
+  static P3Table table;
+  return table;
+}
+
+std::string P3TranslatorInputsText(const SpirvShaderTranslator::Features& f, int msaa_2x_attachments,
+                                   int msaa_2x_no_attachments, int edram_fsi, uint32_t scale_x,
+                                   uint32_t scale_y) {
+  return fmt::format(
+      "spirv_version {}\nmax_storage_buffer_range {}\nfull_draw_index_uint32 {}\n"
+      "vertex_pipeline_stores_and_atomics {}\nfragment_stores_and_atomics {}\n"
+      "clip_distance {}\ncull_distance {}\nimage_view_format_swizzle {}\n"
+      "signed_zero_inf_nan_preserve_float32 {}\ndenorm_flush_to_zero_float32 {}\n"
+      "rounding_mode_rte_float32 {}\nfragment_shader_sample_interlock {}\n"
+      "demote_to_helper_invocation {}\nsample_rate_shading {}\n"
+      "native_2x_msaa_with_attachments {}\nnative_2x_msaa_no_attachments {}\n"
+      "edram_fragment_shader_interlock {}\ndraw_resolution_scale_x {}\n"
+      "draw_resolution_scale_y {}\n",
+      f.spirv_version, f.max_storage_buffer_range, int(f.full_draw_index_uint32),
+      int(f.vertex_pipeline_stores_and_atomics), int(f.fragment_stores_and_atomics),
+      int(f.clip_distance), int(f.cull_distance), int(f.image_view_format_swizzle),
+      int(f.signed_zero_inf_nan_preserve_float32), int(f.denorm_flush_to_zero_float32),
+      int(f.rounding_mode_rte_float32), int(f.fragment_shader_sample_interlock),
+      int(f.demote_to_helper_invocation), int(f.sample_rate_shading), msaa_2x_attachments,
+      msaa_2x_no_attachments, edram_fsi, scale_x, scale_y);
+}
+
+template <typename T>
+T P3Read(const std::vector<uint8_t>& b, size_t o) {
+  T v;
+  std::memcpy(&v, b.data() + o, sizeof(T));
+  return v;
+}
+
+// Loads and validates the table; on any failure the table stays inactive (runtime translation).
+void P3LoadTable(const std::string& path, uint64_t profile_hash) {
+  P3Table& t = p3_table();
+  FILE* fp = rex::filesystem::OpenFile(std::filesystem::path(path), "rb");
+  if (!fp) {
+    REXGPU_ERROR("P3_TABLE_FAIL open {}", path);
+    return;
+  }
+  std::fseek(fp, 0, SEEK_END);
+  long size = std::ftell(fp);
+  std::fseek(fp, 0, SEEK_SET);
+  const size_t kHeader = 8 + 4 + 4 + 8 + 32, kEntry = 8 + 8 + 5 * 4;
+  t.file.resize(kHeader);
+  size_t got = std::fread(t.file.data(), 1, kHeader, fp);
+  if (size <= 0 || got != kHeader || std::memcmp(t.file.data(), "P3SPVTB1", 8) ||
+      P3Read<uint32_t>(t.file, 8) != 1) {
+    REXGPU_ERROR("P3_TABLE_FAIL header {} bytes={}", path, size);
+    std::fclose(fp);
+    return;
+  }
+  uint32_t count = P3Read<uint32_t>(t.file, 12);
+  uint64_t table_profile = P3Read<uint64_t>(t.file, 16);
+  if (table_profile != profile_hash) {
+    REXGPU_ERROR("P3_TABLE_FAIL profile table={:016X} runtime={:016X}", table_profile, profile_hash);
+    std::fclose(fp);
+    return;
+  }
+  if (kHeader + size_t(count) * kEntry > size_t(size)) {
+    REXGPU_ERROR("P3_TABLE_FAIL truncated count={}", count);
+    std::fclose(fp);
+    return;
+  }
+  t.file.resize(kHeader + size_t(count) * kEntry);
+  if (std::fread(t.file.data() + kHeader, 1, size_t(count) * kEntry, fp) != size_t(count) * kEntry) {
+    REXGPU_ERROR("P3_TABLE_FAIL index read count={}", count);
+    std::fclose(fp);
+    return;
+  }
+  got = size_t(size);
+  t.fp = fp;
+  t.file_size = uint64_t(size);
+  for (uint32_t i = 0; i < count; ++i) {
+    size_t o = kHeader + size_t(i) * kEntry;
+    P3Entry e;
+    uint64_t hash = P3Read<uint64_t>(t.file, o), mod = P3Read<uint64_t>(t.file, o + 8);
+    e.spirv_offset = P3Read<uint32_t>(t.file, o + 16);
+    e.spirv_size = P3Read<uint32_t>(t.file, o + 20);
+    e.texture_count = P3Read<uint32_t>(t.file, o + 24);
+    e.sampler_count = P3Read<uint32_t>(t.file, o + 28);
+    e.records_offset = P3Read<uint32_t>(t.file, o + 32);
+    if (size_t(e.spirv_offset) + e.spirv_size > got ||
+        size_t(e.records_offset) + e.texture_count * 3 + e.sampler_count * 5 > got) {
+      REXGPU_ERROR("P3_TABLE_FAIL entry {} out of range", i);
+      t.entries.clear();
+      std::fclose(t.fp);
+      t.fp = nullptr;
+      return;
+    }
+    t.entries[hash][mod] = e;
+  }
+  std::string sha;
+  for (size_t i = 0; i < 32; ++i) {
+    sha += fmt::format("{:02x}", t.file[24 + i]);
+  }
+  t.active = true;
+  REXGPU_INFO("P3_TABLE_OK entries={} profile={:016X} translator_sha256={} path={}", count,
+              profile_hash, sha, path);
+}
