+// DS2: TOML basic strings treat backslash as an escape, so a Windows path written raw
+// made the whole file unparseable on the next start. Escape backslash, quote, newline, tab.
+static std::string TomlQuote(const std::string& v) {
+  constexpr char kBackslash = 92, kQuote = 34;
+  std::string out(1, kQuote);
+  for (char c : v) {
+    if (c == kBackslash || c == kQuote) {
+      out += kBackslash;
+      out += c;
+    } else if (c == 10) {
+      out += kBackslash;
+      out += 'n';
+    } else if (c == 9) {
+      out += kBackslash;
+      out += 't';
+    } else {
+      out += c;
+    }
+  }
+  out += kQuote;
+  return out;
+}
