@@ -0,0 +1,45 @@
+/**
+ * @file        rex/ui/windowed_app_context_nx.h
+ * @brief       Horizon (NX) UI loop + nn::vi window (N2, 2026-10-06)
+ *
+ * The thread that constructs NXWindowedAppContext is the UI thread; it must call RunMainLoop()
+ * (pending UI functions, coalesced paint requests) until QuitFromUIThread().  One window: an
+ * nn::vi layer on the default display, presented through VK_NN_vi_surface.
+ */
+
+#pragma once
+
+#include <rex/platform.h>
+
+#if REX_PLATFORM_NX
+
+#include <atomic>
+#include <condition_variable>
+#include <mutex>
+
+#include <rex/ui/windowed_app_context.h>
+
+namespace rex::ui {
+
+class NXWindowedAppContext final : public WindowedAppContext {
+ public:
+  NXWindowedAppContext() = default;
+  ~NXWindowedAppContext() override;
+
+  // Runs until QuitFromUIThread. Wakes on posted functions; otherwise ticks every 16 ms.
+  void RunMainLoop();
+
+ protected:
+  void NotifyUILoopOfPendingFunctions() override;
+  void PlatformQuitFromUIThread() override;
+
+ private:
+  std::mutex mutex_;
+  std::condition_variable cv_;
+  bool pending_ = false;
+  bool quit_ = false;
+};
+
+}  // namespace rex::ui
+
+#endif  // REX_PLATFORM_NX
diff --git a/resources/templates/codegen/pch_h.inja b/resources/templates/codegen/pch_h.inja
index 68274d2..36f6004 100644
--- a/resources/templates/codegen/pch_h.inja
+++ b/resources/templates/codegen/pch_h.inja
@@ -333,3 +333,116 @@ inline std::atomic<i32>& ppc_global_lock_count_() {
     assert(old_count_ >= 1 && "LeaveGlobalLock called without matching EnterGlobalLock"); \
     rex::thread::global_critical_region::mutex().unlock();                                \
   } while (0)
+
+//=============================================================================
+// S4b NX memory model (opt-in: compile with -DREX_NX_MEMORY_MODEL=1)
+// Kept at the end of the file so a flag-off build is unchanged above this line.
+//=============================================================================
+
+#if defined(REX_NX_MEMORY_MODEL) && REX_NX_MEMORY_MODEL
+#include <rex/system/nx_memory_model.h>
+
+#define REX_NX_LIKELY_FALSE(x) __builtin_expect(!!(x), 0)
+
+inline u8 rex_nx_load_u8(u8* base, u32 a) {
+  if (REX_NX_LIKELY_FALSE(rex::nxmem::IsMmioWindow(a))) {
+    u32 v;
+    if (rex::nxmem::MmioLoad(a, &v)) return static_cast<u8>(v);
+  }
+  return *(volatile u8*)(base + rex::nxmem::HostOffset(a));
+}
+inline u16 rex_nx_load_u16(u8* base, u32 a) {
+  if (REX_NX_LIKELY_FALSE(rex::nxmem::IsMmioWindow(a))) {
+    u32 v;
+    if (rex::nxmem::MmioLoad(a, &v)) return static_cast<u16>(v);
+  }
+  return __builtin_bswap16(*(volatile u16*)(base + rex::nxmem::HostOffset(a)));
+}
+inline u32 rex_nx_load_u32(u8* base, u32 a) {
+  if (REX_NX_LIKELY_FALSE(rex::nxmem::IsMmioWindow(a))) {
+    u32 v;
+    if (rex::nxmem::MmioLoad(a, &v)) return v;
+  }
+  return __builtin_bswap32(*(volatile u32*)(base + rex::nxmem::HostOffset(a)));
+}
+inline u64 rex_nx_load_u64(u8* base, u32 a) {
+  if (REX_NX_LIKELY_FALSE(rex::nxmem::IsMmioWindow(a))) {
+    u32 hi, lo;
+    if (rex::nxmem::MmioLoad(a, &hi)) {
+      rex::nxmem::MmioLoad(a + 4, &lo);
+      return (static_cast<u64>(hi) << 32) | lo;
+    }
+  }
+  return __builtin_bswap64(*(volatile u64*)(base + rex::nxmem::HostOffset(a)));
+}
+
+inline u8* rex_nx_store_ptr(u8* base, u32 a, u32 len) {
+  const u64 off = rex::nxmem::HostOffset(a);
+  if (REX_NX_LIKELY_FALSE(rex::nxmem::StoreHitsWatch(base, off, len))) {
+    rex::nxmem::WatchHit(a, len);
+  }
+  return base + off;
+}
+inline void rex_nx_store_u8(u8* base, u32 a, u8 v) {
+  if (REX_NX_LIKELY_FALSE(rex::nxmem::IsMmioWindow(a)) && rex::nxmem::MmioStore(a, v)) return;
+  *(volatile u8*)rex_nx_store_ptr(base, a, 1) = v;
+}
+inline void rex_nx_store_u16(u8* base, u32 a, u16 v) {
+  if (REX_NX_LIKELY_FALSE(rex::nxmem::IsMmioWindow(a)) && rex::nxmem::MmioStore(a, v)) return;
+  *(volatile u16*)rex_nx_store_ptr(base, a, 2) = __builtin_bswap16(v);
+}
+inline void rex_nx_store_u32(u8* base, u32 a, u32 v) {
+  if (REX_NX_LIKELY_FALSE(rex::nxmem::IsMmioWindow(a)) && rex::nxmem::MmioStore(a, v)) return;
+  *(volatile u32*)rex_nx_store_ptr(base, a, 4) = __builtin_bswap32(v);
+}
+inline void rex_nx_store_u64(u8* base, u32 a, u64 v) {
+  if (REX_NX_LIKELY_FALSE(rex::nxmem::IsMmioWindow(a)) &&
+      rex::nxmem::MmioStore(a, static_cast<u32>(v >> 32))) {
+    rex::nxmem::MmioStore(a + 4, static_cast<u32>(v));
+    return;
+  }
+  *(volatile u64*)rex_nx_store_ptr(base, a, 8) = __builtin_bswap64(v);
+}
+
+#undef REX_RAW_ADDR
+#undef REX_LOAD_U8
+#undef REX_LOAD_U16
+#undef REX_LOAD_U32
+#undef REX_LOAD_U64
+#undef REX_LOAD_STRING
+#undef REX_STORE_U8
+#undef REX_STORE_U16
+#undef REX_STORE_U32
+#undef REX_STORE_U64
+#undef REX_MM_STORE_U8
+#undef REX_MM_STORE_U16
+#undef REX_MM_STORE_U32
+#undef REX_MM_STORE_U64
+#undef REX_MM_LOAD_U8
+#undef REX_MM_LOAD_U16
+#undef REX_MM_LOAD_U32
+#undef REX_MM_LOAD_U64
+
+#define REX_RAW_ADDR(x) (base + rex::nxmem::HostOffset((u32)(x)))
+#define REX_RAW_ADDR_W(x, n) rex_nx_store_ptr(base, (u32)(x), (u32)(n))
+#define REX_LOAD_U8(x) rex_nx_load_u8(base, (u32)(x))
+#define REX_LOAD_U16(x) rex_nx_load_u16(base, (u32)(x))
+#define REX_LOAD_U32(x) rex_nx_load_u32(base, (u32)(x))
+#define REX_LOAD_U64(x) rex_nx_load_u64(base, (u32)(x))
+#define REX_LOAD_STRING(x, len) \
+  std::string_view(reinterpret_cast<const char*>(REX_RAW_ADDR(x)), (len))
+#define REX_STORE_U8(x, y) rex_nx_store_u8(base, (u32)(x), (u8)(y))
+#define REX_STORE_U16(x, y) rex_nx_store_u16(base, (u32)(x), (u16)(y))
+#define REX_STORE_U32(x, y) rex_nx_store_u32(base, (u32)(x), (u32)(y))
+#define REX_STORE_U64(x, y) rex_nx_store_u64(base, (u32)(x), (u64)(y))
+#define REX_MM_STORE_U8(x, y) REX_STORE_U8(x, y)
+#define REX_MM_STORE_U16(x, y) REX_STORE_U16(x, y)
+#define REX_MM_STORE_U32(x, y) REX_STORE_U32(x, y)
+#define REX_MM_STORE_U64(x, y) REX_STORE_U64(x, y)
+#define REX_MM_LOAD_U8(x) REX_LOAD_U8(x)
+#define REX_MM_LOAD_U16(x) REX_LOAD_U16(x)
+#define REX_MM_LOAD_U32(x) REX_LOAD_U32(x)
+#define REX_MM_LOAD_U64(x) REX_LOAD_U64(x)
+#else
+#define REX_RAW_ADDR_W(x, n) REX_RAW_ADDR(x)
+#endif
