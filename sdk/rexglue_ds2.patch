diff --git a/include/rex/audio/nx/nx_audio_system_nx.h b/include/rex/audio/nx/nx_audio_system_nx.h
new file mode 100644
index 0000000..d448f3f
--- /dev/null
+++ b/include/rex/audio/nx/nx_audio_system_nx.h
@@ -0,0 +1,51 @@
+/**
+ * @file        rex/audio/nx/nx_audio_system_nx.h
+ * @brief       Horizon (NX) audio on nn::audio AudioOut (P6, 2026-10-06)
+ *
+ * 48 kHz stereo PCM16.  Each guest XAudio frame (6 ch x 256 samples, big-endian float, sequential)
+ * is folded to stereo with the same conversion the SDL driver uses (StereoFold + output gain), and
+ * written into one AudioOut buffer.  A dedicated nn::os thread at a high fixed priority waits on
+ * the AudioOut buffer event; for each released buffer it refills it from the guest queue and
+ * releases the client semaphore once (exactly where the SDL callback releases it), so the guest
+ * render callback is clocked by the real output at 48000/256 = 187.5 Hz.  When no guest frame is
+ * queued the buffer is refilled with silence and the underrun counter grows.
+ * NxNullAudioSystem stays available (app selects it with P6_AUDIO=null).
+ */
+
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+
+#include <rex/audio/audio_system.h>
+
+namespace rex::audio::nx {
+
+struct NxAudioStats {
+  std::atomic<uint64_t> submitted{0};    // guest frames handed to SubmitFrame
+  std::atomic<uint64_t> played{0};       // guest frames written to AudioOut buffers
+  std::atomic<uint64_t> underruns{0};    // released buffers refilled with silence after start
+  std::atomic<uint64_t> nonsilent{0};    // played frames with any |sample| > 0
+  std::atomic<uint64_t> wakeups{0};      // audio thread event wakeups
+  std::atomic<int64_t> hw_played_samples{0};  // GetAudioOutPlayedSampleCount
+  std::atomic<int32_t> open_result{-1};  // 0 = AudioOut open+start ok, else Result inner value
+  std::atomic<int32_t> rate{0};
+  std::atomic<int32_t> channels{0};
+};
+
+NxAudioStats& GetNxAudioStats();
+
+class NxAudioSystem : public AudioSystem {
+ public:
+  explicit NxAudioSystem(runtime::FunctionDispatcher* function_dispatcher);
+  ~NxAudioSystem() override;
+
+  static bool IsAvailable() { return true; }
+  static std::unique_ptr<AudioSystem> Create(runtime::FunctionDispatcher* function_dispatcher);
+
+  X_STATUS CreateDriver(size_t index, rex::thread::Semaphore* semaphore,
+                        AudioDriver** out_driver) override;
+  void DestroyDriver(AudioDriver* driver) override;
+};
+
+}  // namespace rex::audio::nx
diff --git a/include/rex/audio/nx/nx_null_audio_system_nx.h b/include/rex/audio/nx/nx_null_audio_system_nx.h
new file mode 100644
index 0000000..f96d5dd
--- /dev/null
+++ b/include/rex/audio/nx/nx_null_audio_system_nx.h
@@ -0,0 +1,31 @@
+/**
+ * @file        rex/audio/nx/nx_null_audio_system_nx.h
+ * @brief       Horizon (NX) clocked null audio: silence, but frames are consumed in real time
+ *
+ * NopAudioSystem refuses CreateDriver, so XAudioRegisterRenderDriverClient fails and the guest's
+ * render callback is never pumped (R1-14 on PC; N2 Eden run15 stalls right after
+ * "RwAudioCore Dac").  This system's driver drops every submitted frame (silence) and releases
+ * the client semaphore once per frame at the hardware rate (256 samples at 48 kHz), exactly where
+ * the SDL driver releases it after mixing.  It is the NX audio until nn::audio lands.
+ */
+
+#pragma once
+
+#include <rex/audio/audio_system.h>
+
+namespace rex::audio::nx {
+
+class NxNullAudioSystem : public AudioSystem {
+ public:
+  explicit NxNullAudioSystem(runtime::FunctionDispatcher* function_dispatcher);
+  ~NxNullAudioSystem() override;
+
+  static bool IsAvailable() { return true; }
+  static std::unique_ptr<AudioSystem> Create(runtime::FunctionDispatcher* function_dispatcher);
+
+  X_STATUS CreateDriver(size_t index, rex::thread::Semaphore* semaphore,
+                        AudioDriver** out_driver) override;
+  void DestroyDriver(AudioDriver* driver) override;
+};
+
+}  // namespace rex::audio::nx
