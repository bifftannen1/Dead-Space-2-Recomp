index 0000000..afd8e0f
--- /dev/null
+++ b/src/audio/nx/nx_null_audio_system_nx.cpp
@@ -0,0 +1,79 @@
+/**
+ * @file        audio/nx/nx_null_audio_system_nx.cpp
+ * @brief       Horizon (NX) clocked null audio (N2, 2026-10-06) - see the header.
+ */
+
+#include <rex/audio/audio_driver.h>
+#include <rex/audio/nx/nx_null_audio_system_nx.h>
+#include <rex/logging.h>
+#include <rex/thread.h>
+
+#include <atomic>
+#include <chrono>
+#include <thread>
+
+namespace rex::audio::nx {
+
+namespace {
+// One XAudio frame = 256 samples per channel at 48 kHz.
+constexpr auto kFramePeriod = std::chrono::nanoseconds(256'000'000'000LL / 48000);
+constexpr int kMaxQueued = 8;  // same depth the SDL driver reports (queued_frames=8)
+
+class NxNullAudioDriver final : public AudioDriver {
+ public:
+  NxNullAudioDriver(memory::Memory* memory, rex::thread::Semaphore* semaphore)
+      : AudioDriver(memory), semaphore_(semaphore) {
+    clock_ = std::thread([this] { Clock(); });
+  }
+  ~NxNullAudioDriver() override {
+    stop_ = true;
+    if (clock_.joinable()) clock_.join();
+  }
+  void SubmitFrame(uint32_t samples_ptr) override {
+    (void)samples_ptr;  // silence: the frame is consumed by the clock below
+    if (queued_.load() < kMaxQueued) ++queued_;
+  }
+
+ private:
+  void Clock() {
+    auto next = std::chrono::steady_clock::now();
+    while (!stop_) {
+      next += kFramePeriod;
+      std::this_thread::sleep_until(next);
+      int q = queued_.load();
+      while (q > 0 && !queued_.compare_exchange_weak(q, q - 1)) {
+      }
+      if (q > 0) semaphore_->Release(1, nullptr);
+      const auto now = std::chrono::steady_clock::now();
+      if (now - next > std::chrono::milliseconds(100)) next = now;  // don't burst after a stall
+    }
+  }
+
+  rex::thread::Semaphore* semaphore_;
+  std::atomic<int> queued_{0};
+  std::atomic<bool> stop_{false};
+  std::thread clock_;
+};
