index 0000000..5cd0eda
--- /dev/null
+++ b/src/core/fs_impl_nx.cpp
@@ -0,0 +1,258 @@
+/**
+ * @file        core/fs_impl_nx.cpp
+ * @brief       Horizon (NX): the libc++ std::filesystem operations the SDK uses (N2, 2026-10-06)
+ *
+ * The NX toolchain ships libc++ 13 headers without libc++fs, so the out-of-line pieces the SDK
+ * references (census: path::__filename/__parent_path/__root_directory, __status, __absolute,
+ * __create_directories, __file_size, __remove, __remove_all, __rename) are implemented here on
+ * nn::fs (mount-qualified paths such as "sd:/ds2nx/user").  Semantics follow libc++ for the POSIX
+ * path grammar ('/' only, no root-name); a "mount:/..." path is treated as absolute.
+ * Also: inet_addr (absent from nnSdk's libc).
+ */
+
+#include <rex/platform.h>
+static_assert(REX_PLATFORM_NX, "This file is Horizon-only");
+
+#include <nn/fs.h>
+
+#include <arpa/inet.h>
+#include <pthread.h>
+#include <signal.h>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <cstdlib>
+#include <cerrno>
+#include <nn/os/os_Random.h>
+#include <filesystem>
+#include <string>
+#include <system_error>
+
+namespace std {
+inline namespace __1 {
+namespace __fs {
+namespace filesystem {
+
+namespace {
+using sv = path::__string_view;
+using str = ::std::string;
+
+void set(error_code* ec, errc e) {
+  if (ec) *ec = make_error_code(e);
+}
+void clr(error_code* ec) {
+  if (ec) ec->clear();
+}
+bool is_mount_abs(const str& s) {
+  auto c = s.find(':');
+  auto sl = s.find('/');
+  return c != str::npos && c > 0 && (sl == str::npos || c < sl) && c + 1 < s.size() && s[c + 1] == '/';
+}
+}  // namespace
+
+sv path::__root_directory() const {
+  if (!__pn_.empty() && __pn_[0] == '/') return sv(__pn_.data(), 1);
+  return sv();
+}
+
+sv path::__filename() const {
+  if (__pn_.empty() || __pn_.back() == '/') return sv();
+  auto p = __pn_.rfind('/');
+  if (p == str::npos) return sv(__pn_);
+  return sv(__pn_.data() + p + 1, __pn_.size() - p - 1);
+}
+
+sv path::__parent_path() const {
+  const str& s = __pn_;
+  if (s.empty()) return sv();
+  if (s.find_first_not_of('/') == str::npos) return sv(s);  // only a root directory
+  size_t end;
+  if (s.back() == '/') {
+    end = s.size();
+    while (end > 0 && s[end - 1] == '/') --end;
+  } else {
+    auto p = s.rfind('/');
+    if (p == str::npos) return sv();
+    end = p;
+    while (end > 0 && s[end - 1] == '/') --end;
+    if (end == 0) return sv(s.data(), 1);
+  }
+  return sv(s.data(), end);
+}
+
+file_status __status(const path& p, error_code* ec) {
+  nn::fs::DirectoryEntryType t;
+  nn::Result r = nn::fs::GetEntryType(&t, p.c_str());
+  if (r.IsFailure()) {
+    if (nn::fs::ResultPathNotFound::Includes(r)) {
+      set(ec, errc::no_such_file_or_directory);
+      return file_status(file_type::not_found);
+    }
+    set(ec, errc::io_error);
+    return file_status(file_type::none);
+  }
+  clr(ec);
+  return file_status(t == nn::fs::DirectoryEntryType_Directory ? file_type::directory
+                                                               : file_type::regular,
+                     perms::all);
+}
+
+file_status __symlink_status(const path& p, error_code* ec) { return __status(p, ec); }
+
+path __absolute(const path& p, error_code* ec) {
+  clr(ec);
+  return p;  // nn::fs has no working directory: every usable path is already mount-qualified
+}
+
+bool __create_directories(const path& p, error_code* ec) {
+  const str& s = p.native();
+  bool created = false;
+  size_t start = is_mount_abs(s) ? s.find('/') + 1 : 0;
+  for (size_t i = start; i <= s.size(); ++i) {
+    if (i != s.size() && s[i] != '/') continue;
+    str sub = s.substr(0, i);
+    if (sub.empty() || sub.back() == ':' || sub.back() == '/') continue;
+    nn::fs::DirectoryEntryType t;
+    if (nn::fs::GetEntryType(&t, sub.c_str()).IsSuccess()) {
+      if (t != nn::fs::DirectoryEntryType_Directory) {
+        set(ec, errc::not_a_directory);
+        return false;
+      }
+      continue;
+    }
+    if (nn::fs::CreateDirectory(sub.c_str()).IsFailure()) {
+      set(ec, errc::io_error);
+      return false;
+    }
+    created = true;
+  }
+  clr(ec);
+  return created;
+}
+
+uintmax_t __file_size(const path& p, error_code* ec) {
+  nn::fs::FileHandle h;
+  if (nn::fs::OpenFile(&h, p.c_str(), nn::fs::OpenMode_Read).IsFailure()) {
+    set(ec, errc::no_such_file_or_directory);
+    return uintmax_t(-1);
+  }
+  int64_t size = 0;
+  nn::Result r = nn::fs::GetFileSize(&size, h);
+  nn::fs::CloseFile(h);
+  if (r.IsFailure()) {
+    set(ec, errc::io_error);
+    return uintmax_t(-1);
+  }
+  clr(ec);
+  return uintmax_t(size);
+}
+
+bool __remove(const path& p, error_code* ec) {
+  nn::fs::DirectoryEntryType t;
+  if (nn::fs::GetEntryType(&t, p.c_str()).IsFailure()) {
+    set(ec, errc::no_such_file_or_directory);
+    return false;
+  }
+  nn::Result r = t == nn::fs::DirectoryEntryType_Directory ? nn::fs::DeleteDirectory(p.c_str())
+                                                           : nn::fs::DeleteFile(p.c_str());
+  if (r.IsFailure()) {
+    set(ec, errc::io_error);
+    return false;
+  }
+  clr(ec);
+  return true;
+}
+
+uintmax_t __remove_all(const path& p, error_code* ec) {
+  nn::fs::DirectoryEntryType t;
+  if (nn::fs::GetEntryType(&t, p.c_str()).IsFailure()) {
+    clr(ec);
+    return 0;
+  }
+  nn::Result r = t == nn::fs::DirectoryEntryType_Directory
+                     ? nn::fs::DeleteDirectoryRecursively(p.c_str())
+                     : nn::fs::DeleteFile(p.c_str());
+  if (r.IsFailure()) {
+    set(ec, errc::io_error);
+    return uintmax_t(-1);
+  }
+  clr(ec);
+  return 1;  // nn::fs does not report the count; callers only test for failure
+}
+
+void __rename(const path& from, const path& to, error_code* ec) {
+  nn::fs::DirectoryEntryType t;
+  if (nn::fs::GetEntryType(&t, from.c_str()).IsFailure()) {
+    set(ec, errc::no_such_file_or_directory);
+    return;
+  }
+  nn::fs::DirectoryEntryType tt;
+  if (t != nn::fs::DirectoryEntryType_Directory && nn::fs::GetEntryType(&tt, to.c_str()).IsSuccess()) {
+    nn::fs::DeleteFile(to.c_str());  // POSIX rename replaces an existing file
+  }
+  nn::Result r = t == nn::fs::DirectoryEntryType_Directory
+                     ? nn::fs::RenameDirectory(from.c_str(), to.c_str())
+                     : nn::fs::RenameFile(from.c_str(), to.c_str());
+  if (r.IsFailure()) set(ec, errc::io_error);
+  else clr(ec);
+}
+
+sv path::__stem() const {
+  sv f = __filename();
+  if (f.empty() || f == "." || f == "..") return f;
+  auto d = f.rfind('.');
+  if (d == sv::npos || d == 0) return f;
+  return f.substr(0, d);
+}
+
+path __current_path(error_code* ec) {
+  clr(ec);
+  return path("sd:/");  // nn::fs has no working directory; the SD mount root stands in
+}
+
+// Directory iteration is referenced only by logging.cpp's sequential log naming, which N2 does not
+// use (it passes extra_sinks and no app_name). Iterators are always the end iterator and say so.
+directory_iterator::directory_iterator(const path& p, error_code* ec, directory_options) {
+  (void)p;
+  set(ec, errc::function_not_supported);
+}
+directory_iterator& directory_iterator::__increment(error_code* ec) {
+  set(ec, errc::function_not_supported);
+  __imp_.reset();
+  return *this;
+}
+const directory_entry& directory_iterator::__dereference() const {
+  std::abort();  // unreachable: an end iterator is never dereferenced
+}
+
+}  // namespace filesystem
+}  // namespace __fs
+}  // namespace __1
+}  // namespace std
+
+extern "C" in_addr_t inet_addr(const char* cp) {
+  unsigned a, b, c, d;
+  char tail;
+  if (!cp || std::sscanf(cp, "%u.%u.%u.%u%c", &a, &b, &c, &d, &tail) != 4 || a > 255 || b > 255 ||
+      c > 255 || d > 255) {
+    return in_addr_t(0xFFFFFFFFu);  // INADDR_NONE
+  }
+  return in_addr_t(__builtin_bswap32((a << 24) | (b << 16) | (c << 8) | d));
+}
+
+// libc entry points nnSdk's libc declares but does not export (N2 link census). Horizon has no
+// POSIX signals or thread cancellation: these fail with ENOSYS and threading_posix.cpp logs the
+// failure (cross-thread suspend / APC / terminate are therefore unavailable on NX; N2 NOTES).
+extern "C" {
+int sigaction(int, const struct sigaction*, struct sigaction*) { errno = ENOSYS; return -1; }
+int sigemptyset(sigset_t* set) { if (set) std::memset(set, 0, sizeof(*set)); return 0; }
+int pthread_kill(pthread_t, int) { return ENOSYS; }
+int pthread_cancel(pthread_t) { return ENOSYS; }
+int __libc_current_sigrtmin(void) { return 34; }
+int fsync(int) { return 0; }  // nn::fs writes in this layer are flushed by the callers
+uint32_t arc4random(void) {
+  uint32_t v = 0;
+  nn::os::GenerateRandomBytes(&v, sizeof(v));
+  return v;
+}
+}
