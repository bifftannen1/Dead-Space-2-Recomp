diff --git a/include/rex/input/ps5/ps5_input_driver.h b/include/rex/input/ps5/ps5_input_driver.h
new file mode 100644
index 00000000..870db03b
--- /dev/null
+++ b/include/rex/input/ps5/ps5_input_driver.h
@@ -0,0 +1,58 @@
+#pragma once
+/**
+ * [ps5 port] DualSense controllers through scePad: one device per logged-in
+ * PS5 user that has a controller (the first is Xbox 360 pad 1).
+ *
+ * Mapping (Xbox 360 <- DualSense): A <- Cross, B <- Circle, X <- Square,
+ * Y <- Triangle, LB/RB <- L1/R1, LT/RT <- L2/R2 (analog), START <- Options,
+ * BACK <- touchpad click, stick clicks <- L3/R3, d-pad <- d-pad.
+ */
+#include <array>
+#include <cstdint>
+#include <memory>
+#include <mutex>
+#include <vector>
+
+#include <rex/input/input_driver.h>
+
+namespace rex::input::ps5 {
+
+class Ps5InputDriver final : public InputDriver {
+ public:
+  Ps5InputDriver();
+  ~Ps5InputDriver() override;
+
+  X_STATUS Setup() override;
+  void EnumerateDevices(std::vector<DeviceInfo>& out) override;
+  X_RESULT GetDeviceState(DeviceId id, X_INPUT_STATE* out_state) override;
+  X_RESULT GetDeviceCapabilities(DeviceId id, uint32_t flags,
+                                 X_INPUT_CAPABILITIES* out_caps) override;
+  X_RESULT SetDeviceVibration(DeviceId id, X_INPUT_VIBRATION* vibration) override;
+  X_RESULT GetDeviceKeystroke(DeviceId id, uint32_t flags,
+                              X_INPUT_KEYSTROKE* out_keystroke) override;
+
+ private:
+  static constexpr size_t kMaxPads = 4;
+  struct Pad {
+    int32_t user_id = -1;
+    int32_t handle = -1;
+    DeviceId id = DeviceId::kInvalid;
+    uint32_t packet_number = 0;
+    X_INPUT_GAMEPAD last_gamepad{};
+    uint32_t keystroke_buttons = 0;  // the buttons the keystroke events last reported
+  };
+  Pad* PadFor(DeviceId id);
+  // Opens a pad for every logged-in user that hasn't one yet (users log in and
+  // controllers connect while the game runs). At most twice a second.
+  void RefreshPads();
+  X_RESULT ReadState(Pad& pad, bool active, X_INPUT_STATE* out_state);
+
+  std::mutex mutex_;
+  std::array<Pad, kMaxPads> pads_{};
+  uint64_t last_refresh_ms_ = 0;
+  uint64_t next_id_ = 1;
+};
+
+std::unique_ptr<InputDriver> CreatePs5InputDriver();
+
+}  // namespace rex::input::ps5
