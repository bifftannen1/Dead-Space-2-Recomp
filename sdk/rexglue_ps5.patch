+void Ps5DiagMonitor() {
+  using namespace rex::ps5diag;
+  uint64_t last_swaps = 0, stuck_ticks = 0, samples = 0;
+  for (int tick = 1;; ++tick) {
+    // A thread crashed: the crash hook ends the game; if it hangs (flushing
+    // the log behind a lock the crashed thread holds), this does.
+    for (int i = 0; i < 100; ++i) {
+      std::this_thread::sleep_for(std::chrono::milliseconds(100));
+      if (const uint64_t crashed = crashed_at_ms.load(std::memory_order_acquire)) {
+        if (NowMs() - crashed > 5000) _exit(1);
+      }
+    }
+    if (crashed_at_ms.load(std::memory_order_acquire) || !REXCVAR_GET(ps5_diag_monitor)) continue;
+    const uint64_t swaps = Get(kSwaps);
+    REXLOG_INFO(
+        "ps5 diag {}s: frames {} ({:.1f}/s), faults {} (mmio {}, watch {}, unhandled {}), vblanks {}, "
+        "interrupts {}, ring writes {}, ring batches {}",
+        tick * 10, swaps, double(swaps - last_swaps) / 10.0, Get(kAccessViolations), Get(kMmioAccesses),
+        Get(kWatchFaults), Get(kUnhandledFaults), Get(kVblanks), Get(kInterrupts), Get(kWritePointer),
+        Get(kPrimaryBuffers));
+    // The game stopped presenting frames for 30 s: where every thread is
+    // (twice at most, 30 s apart, so the log stays readable).
+    stuck_ticks = swaps == last_swaps ? stuck_ticks + 1 : 0;
+    last_swaps = swaps;
+    if ((stuck_ticks == 3 || stuck_ticks == 6) && samples < 4) {
+      ++samples;
+      REXLOG_INFO("ps5 diag: no new frame for {} s; where the threads are:", stuck_ticks * 10);
+      SampleAllThreads();
+      rex::FlushLogging();
+    }
+  }
+}
+
+}  // namespace
+
+int main(int argc, char* argv[]) {
+  chdir("/app0");
+  rex::ps5diag::RegisterThread("main");
+  // A thread that crashed (it would retry its faulting instruction forever,
+  // behind a frozen picture): say so and close the game. It runs in the fault
+  // handler, maybe inside the allocator: no logging, which allocates. The
+  // crash line is already at the end of the log file.
+  rex::ps5diag::crash_hook = [](const char*) {
+    Ps5Notify("Dead Space 2 crashed - the log is in the app's logs folder");
+    spdlog::apply_all([](const std::shared_ptr<spdlog::logger>& l) { l->flush(); });
+    sleep(2);
+    _exit(1);
+  };
+  // The game asked to quit (to the dashboard): close the app.
+  rex::ps5diag::title_exit_hook = [] {
+    REXLOG_INFO("the game asked to quit - closing");
+    spdlog::apply_all([](const std::shared_ptr<spdlog::logger>& l) { l->flush(); });
+    _exit(0);
+  };
+  std::set_terminate(Ps5Terminate);
+  std::thread(Ps5DiagMonitor).detach();
+  // No command line on the PS5 (argv can be empty): flags come from ds2.toml.
+  char program[] = "eboot.bin";
+  char* fallback_argv[] = {program, nullptr};
+  if (argc < 1 || !argv || !argv[0]) {
+    argc = 1;
+    argv = fallback_argv;
+  }
+  const int result = RunWindowedApp(argc, argv);
+  if (result != 0) {
+    Ps5Notify("Dead Space 2 stopped with an error - see the app's logs folder");
+    sleep(2);  // (let the notification show)
+  }
+  // Leave without the C runtime's exit handlers (with the game's threads
+  // still around, they end in a crash report).
+  _exit(result);
+}
+
