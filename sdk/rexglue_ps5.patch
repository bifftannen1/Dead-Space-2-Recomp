+  void Close(uint64_t truncate_size) override {
+    if (data_) {
+      Flush();
+      std::free(data_);
+      data_ = nullptr;
+    }
+    if (fd_ >= 0) {
+      if (truncate_size) ftruncate(fd_, off_t(truncate_size));
+      close(fd_);
+      fd_ = -1;
+    }
+  }
