+class Ps5FileCopy : public MappedMemory {
+ public:
+  Ps5FileCopy(void* data, size_t size, int fd, size_t offset, bool writable)
+      : MappedMemory(data, size), fd_(fd), offset_(offset), writable_(writable) {}
+  ~Ps5FileCopy() override { Close(0); }
