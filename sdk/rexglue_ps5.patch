+bool ReadAll(int fd, uint8_t* p, size_t length, size_t offset) {
+  while (length) {
+    const ssize_t n = pread(fd, p, length, off_t(offset));
+    if (n < 0 && errno == EINTR) continue;
+    if (n <= 0) return false;
+    p += n, offset += size_t(n), length -= size_t(n);
+  }
+  return true;
